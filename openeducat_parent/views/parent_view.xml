<?xml version="1.0" encoding="UTF-8"?>
<odoo>

        <record model="ir.ui.view" id="parent_student_form_view">
            <field name="name">op.student.form</field>
            <field name="model">op.student</field>
            <field name="inherit_id" ref="openeducat_core.view_op_student_form"/>
            <field name="priority" eval="12"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="get_parent"
                        class="btn oe_stat_button"
                        icon="fa-user-o"
                        type="object"
                        groups="openeducat_parent.group_op_parent_manager">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_text">أولياء الأمور</span>
                        </div>
                    </button>
                </xpath>
            </field>
        </record>

        <record id="view_op_parent_tree" model="ir.ui.view">
            <field name="name">op.parent.list</field>
            <field name="model">op.parent</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <list string="قائمة أولياء الأمور">
                    <field name="name" string="اسم ولي الأمر"/>
                    <field name="relationship_id" string="صلة القرابة"/>
                    <field name="mobile" required="1" string="رقم الجوال"/>
                    <field name="email" string="البريد الإلكتروني" optional="show"/>
                    <field name="student_ids" widget="many2many_tags" string="الطلاب التابعين"/>
                    <field name="user_id" string="حساب البوابة" widget="many2one_avatar_user" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_op_parent_form" model="ir.ui.view">
            <field name="name">op.parent.form</field>
            <field name="model">op.parent</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <form string="ملف ولي الأمر">
                    <header>
                        <button type="object" name="create_parent_user"
                                string="إنشاء حساب في بوابة أولياء الأمور"
                                groups="openeducat_parent.group_op_parent_manager"
                                class="oe_highlight btn-primary"
                                invisible="user_id != False"/>
                    </header>
                    <sheet>
                        <field name="active" invisible="True"/>
                        <widget name="web_ribbon" title="مؤرشف" bg_color="bg-danger"
                                invisible="active == True"/>
                        <div class="oe_title mb-3">
                            <label for="name" string="اسم ولي الأمر"/>
                            <h1>
                                <field name="name" placeholder="مثال: عبدالله محمد بن صالح الشمري"/>
                            </h1>
                        </div>
                        <group>
                            <group string="بيانات الاتصال والتواصل">
                                <field name="mobile" string="رقم الجوال (لإشعارات واتساب)" placeholder="05XXXXXXXX"/>
                                <field name="email" string="البريد الإلكتروني" placeholder="parent@example.com"/>
                            </group>
                            <group string="الصلة وحساب النظام">
                                <field name="relationship_id" required="1" string="صلة القرابة"/>
                                <field name="user_id" readonly="1" string="حساب المستخدم في البوابة"/>
                            </group>
                        </group>
                        <separator colspan="4" string="الطلاب المسجلين تحت إشراف ولي الأمر" class="mt-4 mb-3"/>
                        <field name="student_ids"/>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_op_parent_search" model="ir.ui.view">
            <field name="name">op.parent.search</field>
            <field name="model">op.parent</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <search string="بحث أولياء الأمور">
                    <field name="name" string="اسم ولي الأمر"/>
                    <field name="mobile" string="رقم الجوال"/>
                    <field name="student_ids" string="الطالب التابع"/>
                    <field name="relationship_id" string="صلة القرابة"/>
                    <separator/>
                    <filter string="نشط" name="active" domain="[('active', '=', True)]"/>
                    <filter string="المؤرشفة" name="inactive" domain="[('active', '=', False)]"/>
                    <group>
                        <filter string="صلة القرابة" name="group_by_relationship"
                                domain="[]" context="{'group_by':'relationship_id'}"/>
                        <filter string="اسم ولي الأمر" name="group_by_parent_name"
                                domain="[]" context="{'group_by':'name'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="act_open_op_parent_view">
            <field name="name">أولياء الأمور</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">op.parent</field>
            <field name="binding_view_types">form</field>
            <field name="view_mode">list,form</field>
            <field name="path">parent</field>
            <field name="search_view_id" ref="view_op_parent_search"/>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_op_parent_view_form">
            <field name="act_window_id" ref="act_open_op_parent_view"/>
            <field name="sequence" eval="20"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_op_parent_form"/>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_op_parent_view_tree">
            <field name="act_window_id" ref="act_open_op_parent_view"/>
            <field name="sequence" eval="10"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_op_parent_tree"/>
        </record>

</odoo>
