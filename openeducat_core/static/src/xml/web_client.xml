<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">

    <!-- SmartEdu Branding in Top Navbar -->
    <t t-inherit="web.NavBar" t-inherit-mode="extension">
        <xpath expr="//t[@t-call='web.NavBar.AppsMenu']" position="before">
            <a href="/odoo" class="smartedu_navbar_brand d-flex align-items-center text-decoration-none px-2" title="سمارت إديو | SmartEdu">
                <img src="/openeducat_core/static/description/smartedu_icon.png" alt="SmartEdu Logo" class="smartedu_navbar_logo" style="height: 28px; width: 28px; border-radius: 7px;"/>
                <span class="smartedu_navbar_name fw-bold d-none d-md-inline" style="color: #ffffff; font-size: 15px; margin-inline-start: 8px;">سمارت <span style="color: #FBBF24;">إديو</span></span>
            </a>
        </xpath>
    </t>

    <t t-name="openeducat_core.InlineCharField" t-inherit="web.CharField" t-inherit-mode="primary">
        <xpath expr="//input" position="attributes">
            <attribute name="style">width:1px;min-width:10px;max-width:100%;display:inline-block;</attribute>
            <attribute name="t-on-input">onInputType</attribute>
        </xpath>
    </t>

    <t t-name="openeducat_core.Many2XAutocomplete" t-inherit="web.Many2XAutocomplete" t-inherit-mode="primary">
        <xpath expr="//input" position="attributes">
            <attribute name="style">width:1px;min-width:10px;max-width:100%;display:inline-block;</attribute>
            <attribute name="t-on-input">onInputTypeMany2One</attribute>
            <attribute name="t-ref">input</attribute>
        </xpath>
    </t>

</templates>
