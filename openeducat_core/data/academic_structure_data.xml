<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- ============================================================ -->
    <!-- 1. المستويات التعليمية (Program Levels)                       -->
    <!-- ============================================================ -->
    <record id="level_kindergarten" model="op.program.level">
        <field name="name">رياض الأطفال (Kindergarten)</field>
    </record>

    <record id="level_primary" model="op.program.level">
        <field name="name">المرحلة الابتدائية (Primary Stage)</field>
    </record>

    <record id="level_middle" model="op.program.level">
        <field name="name">المرحلة المتوسطة / الإعدادية (Middle Stage)</field>
    </record>

    <record id="level_secondary" model="op.program.level">
        <field name="name">المرحلة الثانوية (Secondary Stage)</field>
    </record>

    <!-- ============================================================ -->
    <!-- 2. البرامج الدراسية (Programs)                               -->
    <!-- ============================================================ -->
    <record id="prog_kg" model="op.program">
        <field name="name">برنامج رياض الأطفال والتعليم المبكر</field>
        <field name="code">KG-PROG</field>
        <field name="program_level_id" ref="level_kindergarten"/>
    </record>

    <record id="prog_primary" model="op.program">
        <field name="name">برنامج التعليم الابتدائي العام</field>
        <field name="code">PRI-PROG</field>
        <field name="program_level_id" ref="level_primary"/>
    </record>

    <record id="prog_middle" model="op.program">
        <field name="name">برنامج التعليم المتوسط / الإعدادي</field>
        <field name="code">MID-PROG</field>
        <field name="program_level_id" ref="level_middle"/>
    </record>

    <record id="prog_sec_gen" model="op.program">
        <field name="name">برنامج الثانوية العامة - المسار العام</field>
        <field name="code">SEC-GEN</field>
        <field name="program_level_id" ref="level_secondary"/>
    </record>

    <record id="prog_sec_tech" model="op.program">
        <field name="name">برنامج الثانوية - مسار علوم الحاسب والهندسة</field>
        <field name="code">SEC-TECH</field>
        <field name="program_level_id" ref="level_secondary"/>
    </record>

    <record id="prog_sec_health" model="op.program">
        <field name="name">برنامج الثانوية - مسار الصحة والحياة</field>
        <field name="code">SEC-HLTH</field>
        <field name="program_level_id" ref="level_secondary"/>
    </record>

    <record id="prog_sec_business" model="op.program">
        <field name="name">برنامج الثانوية - مسار إدارة الأعمال</field>
        <field name="code">SEC-BUS</field>
        <field name="program_level_id" ref="level_secondary"/>
    </record>

    <!-- ============================================================ -->
    <!-- 3. المواد الدراسية الوطنية الأساسية (Subjects)               -->
    <!-- ============================================================ -->
    <record id="subj_quran" model="op.subject">
        <field name="name">القرآن الكريم والدراسات الإسلامية</field>
        <field name="code">ISL-101</field>
        <field name="type">theory</field>
        <field name="subject_type">compulsory</field>
    </record>

    <record id="subj_arabic" model="op.subject">
        <field name="name">اللغة العربية (لغتي الجميلة)</field>
        <field name="code">ARB-101</field>
        <field name="type">theory</field>
        <field name="subject_type">compulsory</field>
    </record>

    <record id="subj_math" model="op.subject">
        <field name="name">الرياضيات</field>
        <field name="code">MTH-101</field>
        <field name="type">theory</field>
        <field name="subject_type">compulsory</field>
    </record>

    <record id="subj_science" model="op.subject">
        <field name="name">العلوم العامة</field>
        <field name="code">SCI-101</field>
        <field name="type">both</field>
        <field name="subject_type">compulsory</field>
    </record>

    <record id="subj_english" model="op.subject">
        <field name="name">اللغة الإنجليزية (English Language)</field>
        <field name="code">ENG-101</field>
        <field name="type">theory</field>
        <field name="subject_type">compulsory</field>
    </record>

    <record id="subj_social" model="op.subject">
        <field name="name">الدراسات الاجتماعية والمواطنة</field>
        <field name="code">SOC-101</field>
        <field name="type">theory</field>
        <field name="subject_type">compulsory</field>
    </record>

    <record id="subj_digital" model="op.subject">
        <field name="name">المهارات الرقمية والحاسب الآلي</field>
        <field name="code">DIG-101</field>
        <field name="type">practical</field>
        <field name="subject_type">compulsory</field>
    </record>

    <record id="subj_pe" model="op.subject">
        <field name="name">التربية البدنية والدفاع عن النفس</field>
        <field name="code">PED-101</field>
        <field name="type">practical</field>
        <field name="subject_type">compulsory</field>
    </record>

    <record id="subj_art" model="op.subject">
        <field name="name">التربية الفنية</field>
        <field name="code">ART-101</field>
        <field name="type">practical</field>
        <field name="subject_type">compulsory</field>
    </record>

    <record id="subj_physics" model="op.subject">
        <field name="name">الفيزياء</field>
        <field name="code">PHY-201</field>
        <field name="type">both</field>
        <field name="subject_type">compulsory</field>
    </record>

    <record id="subj_chemistry" model="op.subject">
        <field name="name">الكيمياء</field>
        <field name="code">CHM-201</field>
        <field name="type">both</field>
        <field name="subject_type">compulsory</field>
    </record>

    <record id="subj_biology" model="op.subject">
        <field name="name">علم الأحياء</field>
        <field name="code">BIO-201</field>
        <field name="type">both</field>
        <field name="subject_type">compulsory</field>
    </record>

    <record id="subj_ai_data" model="op.subject">
        <field name="name">علم البيانات والذكاء الاصطناعي</field>
        <field name="code">AI-301</field>
        <field name="type">both</field>
        <field name="subject_type">elective</field>
    </record>

    <!-- ============================================================ -->
    <!-- 4. الصفوف والمراحل الدراسية الفعلية (Courses / Grades)        -->
    <!-- ============================================================ -->

    <!-- رياض الأطفال -->
    <record id="course_kg1" model="op.course">
        <field name="name">روضة أولى (KG 1)</field>
        <field name="code">KG-01</field>
        <field name="program_id" ref="prog_kg"/>
        <field name="evaluation_type">normal</field>
        <field name="subject_ids" eval="[(6, 0, [ref('subj_quran'), ref('subj_arabic'), ref('subj_art'), ref('subj_pe')])]"/>
    </record>

    <record id="course_kg2" model="op.course">
        <field name="name">روضة ثانية (KG 2)</field>
        <field name="code">KG-02</field>
        <field name="program_id" ref="prog_kg"/>
        <field name="evaluation_type">normal</field>
        <field name="subject_ids" eval="[(6, 0, [ref('subj_quran'), ref('subj_arabic'), ref('subj_math'), ref('subj_art'), ref('subj_pe')])]"/>
    </record>

    <record id="course_kg3" model="op.course">
        <field name="name">تمهيدي (KG 3 / Pre-K)</field>
        <field name="code">KG-03</field>
        <field name="program_id" ref="prog_kg"/>
        <field name="evaluation_type">normal</field>
        <field name="subject_ids" eval="[(6, 0, [ref('subj_quran'), ref('subj_arabic'), ref('subj_math'), ref('subj_english'), ref('subj_art'), ref('subj_pe')])]"/>
    </record>

