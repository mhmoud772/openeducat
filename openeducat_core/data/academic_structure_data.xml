    <!-- ============================================================ -->
    <!-- 5. العام الدراسي والفصول الدراسية (Academic Year & Terms)     -->
    <!-- ============================================================ -->
    <record id="academic_year_current" model="op.academic.year">
        <field name="name">العام الدراسي 2026-2027 (1448 هـ)</field>
        <field name="start_date">2026-08-20</field>
        <field name="end_date">2027-06-25</field>
        <field name="term_structure">three_sem</field>
    </record>

    <record id="academic_term_1" model="op.academic.term">
        <field name="name">الفصل الدراسي الأول (Term 1)</field>
        <field name="term_start_date">2026-08-20</field>
        <field name="term_end_date">2026-11-20</field>
        <field name="academic_year_id" ref="academic_year_current"/>
    </record>

    <record id="academic_term_2" model="op.academic.term">
        <field name="name">الفصل الدراسي الثاني (Term 2)</field>
        <field name="term_start_date">2026-11-25</field>
        <field name="term_end_date">2027-02-25</field>
        <field name="academic_year_id" ref="academic_year_current"/>
    </record>

    <record id="academic_term_3" model="op.academic.term">
        <field name="name">الفصل الدراسي الثالث (Term 3)</field>
