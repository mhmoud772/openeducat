        <field name="program_id" ref="prog_sec_health"/>
        <field name="evaluation_type">GPA</field>
        <field name="subject_ids" eval="[(6, 0, [ref('subj_chemistry'), ref('subj_biology'), ref('subj_physics'), ref('subj_math'), ref('subj_english')])]"/>
