    </record>

    <record id="batch_m1_a" model="op.batch">
        <field name="name">شعبة (أ) - الأول المتوسط</field>
        <field name="code">M1-A</field>
        <field name="start_date">2026-08-20</field>
        <field name="end_date">2027-06-25</field>
