        <field name="code">SEC-G02-GEN</field>
        <field name="program_id" ref="prog_sec_gen"/>
        <field name="evaluation_type">GPA</field>
        <field name="subject_ids" eval="[(6, 0, [ref('subj_quran'), ref('subj_arabic'), ref('subj_math'), ref('subj_physics'), ref('subj_chemistry'), ref('subj_english')])]"/>
