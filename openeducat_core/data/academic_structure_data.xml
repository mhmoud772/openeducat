    <record id="course_s3_gen" model="op.course">
        <field name="name">الصف الثالث الثانوي - مسار عام</field>
        <field name="code">SEC-G03-GEN</field>
        <field name="program_id" ref="prog_sec_gen"/>
        <field name="evaluation_type">GPA</field>
