    </record>

    <record id="course_p5" model="op.course">
        <field name="name">الصف الخامس الابتدائي</field>
        <field name="code">PRI-G05</field>
        <field name="program_id" ref="prog_primary"/>
        <field name="evaluation_type">normal</field>
        <field name="subject_ids" eval="[(6, 0, [ref('subj_quran'), ref('subj_arabic'), ref('subj_math'), ref('subj_science'), ref('subj_english'), ref('subj_social'), ref('subj_digital'), ref('subj_art'), ref('subj_pe')])]"/>
    </record>

    <record id="course_p6" model="op.course">
        <field name="name">الصف السادس الابتدائي</field>
        <field name="code">PRI-G06</field>
        <field name="program_id" ref="prog_primary"/>
        <field name="evaluation_type">normal</field>
        <field name="subject_ids" eval="[(6, 0, [ref('subj_quran'), ref('subj_arabic'), ref('subj_math'), ref('subj_science'), ref('subj_english'), ref('subj_social'), ref('subj_digital'), ref('subj_art'), ref('subj_pe')])]"/>
    </record>

    <!-- المرحلة المتوسطة / الإعدادية -->
    <record id="course_m1" model="op.course">
        <field name="name">الصف الأول المتوسط / الإعدادي</field>
        <field name="code">MID-G01</field>
        <field name="program_id" ref="prog_middle"/>
        <field name="evaluation_type">GPA</field>
        <field name="subject_ids" eval="[(6, 0, [ref('subj_quran'), ref('subj_arabic'), ref('subj_math'), ref('subj_science'), ref('subj_english'), ref('subj_social'), ref('subj_digital'), ref('subj_art'), ref('subj_pe')])]"/>
    </record>

    <record id="course_m2" model="op.course">
        <field name="name">الصف الثاني المتوسط / الإعدادي</field>
        <field name="code">MID-G02</field>
        <field name="program_id" ref="prog_middle"/>
        <field name="evaluation_type">GPA</field>
        <field name="subject_ids" eval="[(6, 0, [ref('subj_quran'), ref('subj_arabic'), ref('subj_math'), ref('subj_science'), ref('subj_english'), ref('subj_social'), ref('subj_digital'), ref('subj_art'), ref('subj_pe')])]"/>
    </record>

    <record id="course_m3" model="op.course">
        <field name="name">الصف الثالث المتوسط / الإعدادي</field>
        <field name="code">MID-G03</field>
        <field name="program_id" ref="prog_middle"/>
        <field name="evaluation_type">GPA</field>
        <field name="subject_ids" eval="[(6, 0, [ref('subj_quran'), ref('subj_arabic'), ref('subj_math'), ref('subj_science'), ref('subj_english'), ref('subj_social'), ref('subj_digital'), ref('subj_art'), ref('subj_pe')])]"/>
    </record>

    <!-- المرحلة الثانوية (نظام المسارات الحديث) -->
    <record id="course_s1" model="op.course">
        <field name="name">الصف الأول الثانوي (السنة الأولى المشتركة)</field>
        <field name="code">SEC-G01</field>
        <field name="program_id" ref="prog_sec_gen"/>
        <field name="evaluation_type">GPA</field>
        <field name="subject_ids" eval="[(6, 0, [ref('subj_quran'), ref('subj_arabic'), ref('subj_math'), ref('subj_physics'), ref('subj_chemistry'), ref('subj_biology'), ref('subj_english'), ref('subj_digital'), ref('subj_social')])]"/>
    </record>

    <record id="course_s2_gen" model="op.course">
