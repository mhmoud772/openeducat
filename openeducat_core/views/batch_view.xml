<?xml version="1.0" encoding="UTF-8"?>
<odoo>
        <record id="view_op_batch_tree" model="ir.ui.view">
            <field name="name">op.batch.list</field>
            <field name="model">op.batch</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <list string="الشعب والفصول الدراسية" multi_edit="1">
                    <field name="code" string="رمز الشعبة" optional="show"/>
                    <field name="name" string="اسم الشعبة"/>
                    <field name="course_id" string="المرحلة / الصف"/>
                    <field name="start_date" string="تاريخ البدء" optional="show"/>
                    <field name="end_date" string="تاريخ الانتهاء" optional="show"/>
                </list>
            </field>
        </record>

        <record id="view_op_batch_form" model="ir.ui.view">
            <field name="name">op.batch.form</field>
            <field name="model">op.batch</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <form string="الشعبة والفصل الدراسي">
                    <header/>
                    <sheet>
                        <field name="active" invisible="True"/>
                        <widget name="web_ribbon" title="مؤرشف" bg_color="bg-danger"
                                invisible="active == True"/>
                        <div class="oe_title">
                            <label for="name" string="اسم الشعبة / الفصل"/>
                            <h1><field name="name" placeholder="مثال: شعبة أ - عام 2026"/></h1>
                        </div>
                        <group>
                            <group name="main" string="بيانات الشعبة">
                                <field name="code" string="رمز الشعبة"/>
                                <field name="course_id" string="المرحلة / الصف"/>
                            </group>
                            <group string="المدة الزمنية">
                                <field name="start_date" string="تاريخ البدء"/>
                                <field name="end_date" string="تاريخ الانتهاء"/>
                            </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_op_batch_search" model="ir.ui.view">
            <field name="name">op.batch.search</field>
            <field name="model">op.batch</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <search string="البحث في الشعب والفصول">
                    <field name="code" string="رمز الشعبة"/>
                    <field name="name" string="اسم الشعبة"/>
                    <field name="course_id" string="المرحلة / الصف"/>
                    <field name="start_date" string="تاريخ البدء"/>
                    <field name="end_date" string="تاريخ الانتهاء"/>
                    <separator/>
                    <filter name="filter_start_date" string="تاريخ البدء" date="start_date"/>
                    <filter name="filter_end_date" string="تاريخ الانتهاء" date="end_date"/>
                    <separator/>
                    <filter string="المؤرشفة" name="inactive" domain="[('active', '=', False)]"/>
                    <newline/>
                    <group>
                        <filter name="group_by_batch_course"
                                string="المرحلة الدراسية" domain="[]" context="{'group_by':'course_id'}"/>
                        <filter name="group_by_batch_start_date"
                                string="تاريخ البدء" domain="[]"
                                context="{'group_by':'start_date'}"/>
                        <filter name="group_by_batch_end_date"
                                string="تاريخ الانتهاء" domain="[]"
                                context="{'group_by':'end_date'}"/>
                    </group>
                    <searchpanel>
                        <field name="course_id" string="المرحلة الدراسية" icon="fa-book" enable_counters="1"/>
                    </searchpanel>
                </search>
            </field>
        </record>

        <record id="view_op_batch_pivot" model="ir.ui.view">
            <field name="name">op.batch.pivot</field>
            <field name="model">op.batch</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <pivot string="الشعب الدراسية">
                    <field name="name" type="row"/>
                    <field name="course_id"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                </pivot>
            </field>
        </record>

        <record model="ir.actions.act_window" id="act_open_op_batch_view">
            <field name="name">الشعب والفصول الدراسية</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">op.batch</field>
            <field name="path">batches</field>
            <field name="binding_view_types">form</field>
            <field name="view_mode">list,form,pivot</field>
            <field name="search_view_id" ref="view_op_batch_search"/>
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_op_batch_view_form">
            <field name="act_window_id" ref="act_open_op_batch_view"/>
            <field name="sequence" eval="20"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_op_batch_form"/>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_op_batch_view_tree">
            <field name="act_window_id" ref="act_open_op_batch_view"/>
            <field name="sequence" eval="10"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_op_batch_tree"/>
        </record>
</odoo>
