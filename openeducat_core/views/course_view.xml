<?xml version="1.0" encoding="UTF-8"?>
<odoo>
        <record id="view_op_course_tree" model="ir.ui.view">
            <field name="name">op.course.list</field>
            <field name="model">op.course</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <list string="المراحل والصفوف الدراسية" multi_edit="1">
                    <field name="code" string="رمز المرحلة" optional="show"/>
                    <field name="name" string="اسم المرحلة / الصف"/>
                    <field name="evaluation_type" string="نظام التقييم" widget="badge" optional="show"/>
                    <field name="parent_id" string="المرحلة الرئيسية" optional="show"/>
                    <field name="program_id" string="البرنامج التعليمي" optional="show"/>
                    <field name="min_unit_load" string="الحد الأدنى للوحدات" optional="hide"/>
                    <field name="max_unit_load" string="الحد الأقصى للوحدات" optional="hide"/>
                    <field name="subject_ids" string="المواد المسندة" widget="many2many_tags" optional="show"/>
                    <field name="department_id" string="القسم الأكاديمي" groups="openeducat_core.group_multi_department" optional="show"/>
                </list>
            </field>
        </record>

        <record id="view_op_course_form" model="ir.ui.view">
            <field name="name">op.course.form</field>
            <field name="model">op.course</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <form string="المرحلة / الصف الدراسي">
                    <header/>
                    <sheet>
                        <div name="button_box" class="oe_button_box">
                        </div>
                        <field name="active" invisible="True"/>
                        <widget name="web_ribbon" title="مؤرشف" bg_color="bg-danger"
                                invisible = "active == True"/>
                        <div name="combine" class="row d-flex">
                            <div class="oe_title col-9">
                                <h1><field name="name" options="{'line_breaks': False}" widget="text" default_focus="1" placeholder="مثال: الصف الأول الابتدائي / المسار العام"/></h1>
                            </div>
                        </div>
                        <group class="pt-3">
                            <group name="main" string="بيانات المرحلة / الصف">
                                <field name="code" string="الرمز الكودي"/>
                                <field name="evaluation_type" string="نظام التقييم"/>
                                <field name="parent_id" string="المرحلة الرئيسية التابعة لها"/>
                                <field name="department_id" string="القسم" groups="openeducat_core.group_multi_department"/>
                            </group>
                            <group string="الإعدادات والبرنامج">
                                <field name="program_id" string="البرنامج الأكاديمي"/>
                                <field name="min_unit_load" string="الحد الأدنى للوحدات"/>
                                <field name="max_unit_load" string="الحد الأقصى للوحدات"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="المواد الدراسية المسندة" name="subject">
                                <field name="subject_ids" nolabel="1" context="{'default_course_id': id,'default_department_id': department_id}">
                                    <list string="المواد الدراسية">
                                        <field name="code" string="رمز المادة"/>
                                        <field name="name" string="اسم المادة"/>
                                        <field name="type" string="النوع"/>
                                        <field name="subject_type" string="تصنيف المادة" widget="badge" decoration-info="subject_type == 'compulsory'" decoration-warning="subject_type == 'elective'"/>
                                        <field name="grade_weightage" string="الوزن النسبي" optional="show"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_op_course_search" model="ir.ui.view">
            <field name="name">op.course.search</field>
            <field name="model">op.course</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <search string="البحث في المراحل والصفوف">
                    <field name="name" string="المرحلة / الصف" filter_domain="['|',('name','ilike',self),('code','ilike',self)]"/>
                    <field name="code" string="الرمز"/>
                    <field name="evaluation_type" string="نظام التقييم"/>
                    <field name="parent_id" string="المرحلة الرئيسية"/>
                    <field name="program_id" string="البرنامج الأكاديمي"/>
                    <field name="department_id" string="القسم الأكاديمي"/>
                    <separator/>
                    <filter string="المؤرشفة" name="inactive" domain="[('active', '=', False)]"/>
                    <newline/>
                    <group>
                        <filter name="group_by_evaluation_type"
                                string="نظام التقييم" domain="[]"
                                context="{'group_by':'evaluation_type'}"/>
                        <filter name="group_by_partner_course"
                                string="المرحلة الرئيسية" domain="[]"
                                context="{'group_by':'parent_id'}"/>
                        <filter name="group_by_program"
                                string="البرنامج التعليمي" domain="[]"
                                context="{'group_by':'program_id'}"/>
                        <filter name="group_by_department"
                                string="القسم الأكاديمي" domain="[]"
                                context="{'group_by':'department_id'}"/>
                    </group>
                    <searchpanel>
                        <field name="department_id" string="القسم الأكاديمي" icon="fa-building-o" enable_counters="1"/>
                        <field name="evaluation_type" string="نظام التقييم" icon="fa-check-square-o" enable_counters="1"/>
                    </searchpanel>
                </search>
            </field>
        </record>

        <record id="view_op_course_pivot" model="ir.ui.view">
            <field name="name">op.course.pivot</field>
            <field name="model">op.course</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <pivot string="إحصائيات المراحل والصفوف">
                    <field name="name" type="row"/>
                    <field name="parent_id"/>
                    <field name="max_unit_load"/>
                    <field name="min_unit_load"/>
                </pivot>
            </field>
        </record>

        <record model="ir.actions.act_window" id="act_open_op_course_view">
            <field name="name">المراحل والصفوف الدراسية</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">op.course</field>
            <field name="path">courses</field>
            <field name="binding_view_types">form</field>
            <field name="view_mode">list,form,pivot</field>
            <field name="search_view_id" ref="view_op_course_search"/>
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_op_course_view_form">
            <field name="act_window_id" ref="act_open_op_course_view"/>
            <field name="sequence" eval="20"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_op_course_form"/>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_op_course_view_tree">
            <field name="act_window_id" ref="act_open_op_course_view"/>
            <field name="sequence" eval="10"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_op_course_tree"/>
        </record>
</odoo>
