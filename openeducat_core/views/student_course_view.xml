<?xml version="1.0" encoding="UTF-8"?>
<odoo>
        <record id="view_op_student_course_tree" model="ir.ui.view">
            <field name="name">op.student.course.list</field>
            <field name="model">op.student.course</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <list string="تفاصيل المراحل والشعب للطلاب" multi_edit="1">
                    <field name="student_id"/>
                    <field name="course_id"/>
                    <field name="batch_id"/>
                    <field name="roll_number" optional="show"/>
                    <field name="subject_ids" widget="many2many_tags" optional="show"/>
                    <field name="academic_years_id" optional="hide"/>
                    <field name="academic_term_id" optional="hide"/>
                    <field name="state" widget="badge" decoration-info="state == 'running'" decoration-success="state == 'finished'"/>
                </list>
            </field>
        </record>

        <record id="view_op_student_course_form" model="ir.ui.view">
            <field name="name">op.student.course.form</field>
            <field name="model">op.student.course</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <form string="سجل قيد ومرحلة الطالب">
                    <header>
                            <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="student_id"/>
                                <field name="batch_id" domain="[('course_id', '=', course_id)]" required="1"/>
                                <field name="academic_years_id"/>
                            </group>
                            <group>
                                <field name="course_id"/>
                                <field name="roll_number"/>
                                <field name="academic_term_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="المواد الدراسية" name="subjects">
                                <field name="subject_ids" nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_op_student_course_search" model="ir.ui.view">
            <field name="name">op.student.course.search</field>
            <field name="model">op.student.course</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <search string="بحث قيد المراحل والمقررات">
                    <field name="student_id"/>
                    <field name="course_id"/>
                    <field name="batch_id"/>
                    <field name="roll_number"/>
                    <separator/>
                    <filter name="state_running" string="منتظم / مستمر" domain="[('state', '=', 'running')]"/>
                    <filter name="state_finished" string="متخرج / منتهٍ" domain="[('state', '=', 'finished')]"/>
                    <newline/>
                    <group>
                        <filter string="المرحلة / الصف" name="group_by_adm_course_id"
                                domain="[]" context="{'group_by':'course_id'}"/>
                        <filter string="الشعبة / الفصل" name="group_by_adm_batch_id"
                                domain="[]" context="{'group_by':'batch_id'}"/>
                        <filter string="حالة القيد" name="group_by_state"
                                domain="[]" context="{'group_by':'state'}"/>
                        <filter string="العام الدراسي" name="group_by_adm_academic_years_id"
                                domain="[]" context="{'group_by':'academic_years_id'}"/>
                        <filter string="الفصل الدراسي" name="group_by_adm_academic_term_id"
                                domain="[]" context="{'group_by':'academic_term_id'}"/>
                    </group>
                    <searchpanel>
                        <field name="course_id" icon="fa-book" enable_counters="1"/>
                        <field name="state" icon="fa-tasks" enable_counters="1"/>
                    </searchpanel>
                </search>
            </field>
        </record>

        <record id="view_op_student_course_pivot" model="ir.ui.view">
            <field name="name">op.student.course.pivot</field>
            <field name="model">op.student.course</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <pivot string="إحصائيات قيد الطلاب">
                    <field name="student_id"/>
                    <field name="course_id" type="row"/>
                    <field name="batch_id"/>
                </pivot>
            </field>
        </record>

        <record model="ir.actions.act_window" id="act_open_op_student_course_view">
            <field name="name">سجل قيد ومراحل الطلاب</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">op.student.course</field>
            <field name="path">student-course</field>
            <field name="binding_view_types">form</field>
            <field name="view_mode">list,form,pivot</field>
            <field name="search_view_id" ref="view_op_student_course_search"/>
        </record>
</odoo>
