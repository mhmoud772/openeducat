<?xml version="1.0" encoding="UTF-8"?>
<odoo>

        <record id="kanban_view_student" model="ir.ui.view">
            <field name="name">Student Kanban</field>
            <field name="model">op.student</field>
            <field name="arch" type="xml">
                <kanban sample="1" class="o_student_kanban">
                    <field name="id"/>
                    <field name="image_1920"/>
                    <field name="gr_no"/>
                    <field name="course_detail_ids"/>
                    <field name="email"/>
                    <field name="phone"/>
                    <field name="gender"/>
                    <templates>
                        <t t-name="card" class="d-flex flex-column bg-white shadow-sm border-0 p-0" style="border-radius: 8px; overflow: hidden; transition: all 0.2s ease;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 8px 16px rgba(0,0,0,0.1)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 .125rem .25rem rgba(0,0,0,.075)';">
                            <widget name="web_ribbon" title="مؤرشف" bg_color="text-bg-danger" invisible="active"/>

                            <!-- Main Header: Square Image + Contact Info -->
                            <div class="d-flex p-3 w-100">
                                <div class="rounded-3 shadow-sm me-3 bg-white d-flex justify-content-center align-items-center" style="width: 85px; height: 85px; overflow: hidden; flex-shrink: 0; border: 1px solid #e9ecef;">
                                    <t t-if="record.image_1920.value">
                                        <field name="image_1920" class="w-100 h-100" style="object-fit: cover;" widget="image" options="{'img_class': 'w-100 h-100 object-fit-cover'}"/>
                                    </t>
                                    <t t-else="">
                                        <field name="avatar_128" class="w-100 h-100" style="object-fit: cover;" widget="image" options="{'img_class': 'w-100 h-100 object-fit-cover'}"/>
                                    </t>
                                </div>
                                <div class="d-flex flex-column justify-content-center flex-grow-1" style="min-width: 0;">
                                    <field name="name" class="fw-bold text-dark d-block text-truncate mb-1" style="font-size:1.15rem;"/>
                                    <div class="d-flex align-items-center text-truncate mb-1" t-if="record.email.value" style="font-size:0.85rem; min-width: 0;">
                                        <i class="fa fa-envelope text-primary me-2 flex-shrink-0" title="البريد الإلكتروني"/>
                                        <span class="text-truncate d-block text-dark" style="min-width: 0; color: #374151 !important;"><field name="email"/></span>
                                    </div>
                                    <div class="d-flex align-items-center text-truncate" t-if="record.phone.value" style="font-size:0.85rem; min-width: 0;">
                                        <i class="fa fa-phone text-success me-2 flex-shrink-0" title="رقم الهاتف"/>
                                        <span class="text-truncate d-block text-dark" style="min-width: 0; color: #374151 !important;"><field name="phone"/></span>
                                    </div>
                                    <div class="d-flex align-items-center gap-2 mt-1" style="font-size:0.75rem;">
                                        <div t-if="record.gr_no.value" class="text-primary fw-semibold text-truncate" style="background: rgba(13, 110, 253, 0.08); padding: 1px 6px; border-radius: 4px; display: inline-block; width: fit-content;">
                                            #<field name="gr_no"/>
                                        </div>
                                        <div t-if="record.gender.value" class="text-muted fw-semibold" style="background: rgba(108, 117, 125, 0.08); padding: 1px 6px; border-radius: 4px; display: inline-block;">
                                            <field name="gender"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Footer: Activity and Boxed Stats -->
                            <footer class="px-3 py-1 d-flex flex-nowrap align-items-center gap-2 w-100 mt-auto bg-white" style="border-top: 1px solid #dee2e6; min-height: 45px;">
                                <div name="activity_box" class="d-flex align-items-center justify-content-center bg-light px-2 py-1 rounded-3 ms-auto border border-light-subtle" style="height: 32px; color: #212529 !important;">
                                    <field name="activity_ids" widget="kanban_activity"/>
                                </div>
                            </footer>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="view_op_student_tree" model="ir.ui.view">
            <field name="name">op.student.list</field>
            <field name="model">op.student</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <list string="قائمة الطلاب" multi_edit="1">
                    <field name="gr_no" string="رقم القيد" optional="show"/>
                    <field name="title" string="اللقب" optional="hide"/>
                    <field name="name" string="اسم الطالب الرباعي"/>
                    <field name="id_type" string="نوع الوثيقة" optional="show"/>
                    <field name="id_number" string="رقم الهوية / الإقامة" optional="show"/>
                    <field name="gender" string="الجنس" optional="show"/>
                    <field name="birth_date" string="تاريخ الميلاد" optional="show"/>
                    <field name="email" string="البريد الإلكتروني" optional="show" class="truncate-email"/>
                    <field name="phone" string="رقم الهاتف" optional="show"/>
                    <field name="nationality" string="الجنسية" optional="show"/>
                    <field name="category_id" string="الفئة" optional="hide"/>
                    <field name="lang" string="اللغة" optional="hide"/>
                    <field name="blood_group" string="فصيلة الدم" optional="hide"/>
                    <field name="emergency_contact" string="طوارئ" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_op_student_form" model="ir.ui.view">
            <field name="name">op.student.form</field>
            <field name="model">op.student</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <!-- No js_class here. `hr_employee_form` registers hr's
                     EmployeeFormController, which overrides the Archive action
                     to open the "Employee Termination" wizard
                     (hr/static/src/views/archive_employee_hook.js) and passes
                     `this.model.root.resId` as active_ids. On this form that
                     is an op.student id, handed to hr.departure.wizard, which
                     expects an hr.employee id — so archiving a student either
                     errored or wrote departure fields onto whichever employee
                     happened to share that id.

                     It was added in d6485eb0 ([19.0][MOD] updated UI for
                     student and faculty, 2025-10-08) as part of a pure restyle;
                     the styling in that commit is a global .oe_stat_button rule
                     and does not depend on the js_class, so removing it changes
                     appearance not at all and restores the standard Archive. -->
                <form string="بيانات الطالب">
                    <header>
                        <button name="action_print_id_card" string="طباعة بطاقة الهوية" type="object" class="btn btn-primary" icon="fa-id-card-o"/>
                        <button name="action_print_bonafide" string="شهادة تعريف طالب" type="object" class="btn btn-secondary" icon="fa-file-text-o"/>
                        <button name="create_student_user" string="إنشاء حساب للنظام" type="object" class="btn btn-outline-primary" icon="fa-user-plus" invisible="user_id"/>
                    </header>
                    <sheet>
                        <div name="button_box" class="oe_button_box">
                        </div>
                        <field name="active" invisible="True"/>
                        <widget name="web_ribbon" title="مؤرشف" bg_color="bg-danger"
                                invisible ="active == True"/>
                        <div class="row flex-column flex-sm-row align-items-center">
                            <div class="o_employee_avatar ms-2 p-0 h-100 mw-25 align-self-start align-self-sm-center">
                                <field name="image_1920" widget='image' class="m-0" options='{"size": [128,158], "zoom": true, "preview_image":"avatar_128"}'/>
                            </div>
                            <div class="align-self-start o_employee_form_header_info">
                                <div class="oe_title ps-0 pe-2 mw-100">
                                    <h5 class="d-flex align-items-baseline mb-0">
                                        <field name="title" options="{'no_create': True}" placeholder="اللقب"/>
                                    </h5>
                                    <div class="d-flex student-name">
                                        <div class="w-100">
                                            <h1 class="d-md-flex align-items-center gap-2 w-100 flex-wrap">
                                                <field name="name" placeholder="الاسم الكامل" required="1" invisible="True"/>
                                                <field name="first_name" widget="inline_char" required="1" placeholder="الاسم الأول"/>
                                                <field name="middle_name" widget="inline_char" placeholder="اسم الأب"/>
                                                <field name="third_name" widget="inline_char" placeholder="اسم الجد"/>
                                                <field name="last_name" widget="inline_char" placeholder="العائلة / القبيلة"/>
                                            </h1>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-baseline w-md-50">
                                        <i class="fa fa-fw me-1 fa-envelope text-primary" title="البريد الإلكتروني"/>
                                        <field name="email" class="w-100" widget="email" placeholder="البريد الإلكتروني"/>
                                    </div>
                                    <div class="d-flex align-items-baseline w-md-50">
                                        <i class="fa fa-fw me-1 fa-phone text-primary" title="رقم الهاتف"/>
                                        <field name="phone" class="w-100" widget="phone" placeholder="رقم الهاتف"/>
                                    </div>

                                </div>
                            </div>
                        </div>
                        <br/>
                        <notebook colspan="4">
                            <page string="البيانات الشخصية" name="personal_info" autofocus="autofocus">
                                <group>
                                    <group string="بيانات الهوية الوطنية والإقامة">
                                        <field name="id_type" required="1"/>
                                        <field name="id_number" placeholder="مثال: 10XXXXXXXX أو 20XXXXXXXX"/>
                                        <field name="id_issue_place" placeholder="المدينة / المنطقة"/>
                                        <field name="id_issue_date"/>
                                        <field name="id_expiry_date"/>
                                    </group>
                                    <group string="البيانات الأساسية">
                                        <field name="gender" required="1"/>
                                        <field name="birth_date"/>
                                        <field name="nationality"/>
                                        <field name="blood_group"/>
                                        <field name="category_id"/>
                                    </group>
                                </group>
                                <group string="معلومات النظام">
                                    <group>
                                        <field name="gr_no"/>
                                        <field name="certificate_number" invisible="True"/>
                                        <field name="lang"/>
                                    </group>
                                    <group>
                                        <field name="visa_info"/>
                                        <field name="user_id" string="حساب المستخدم" readonly="1"/>
                                        <field name="partner_id" placeholder="جهة الاتصال الشريكة" required="0"/>
                                    </group>
                                </group>
                            </page>
                            <page string="البيانات الأكاديمية" name="academic_info">
                                <field name="course_detail_ids" nolabel="1">
                                    <list string="تفاصيل المراحل والمقررات" editable="bottom">
                                        <field name="course_id" string="المرحلة / الصف" required="1"/>
                                        <field name="batch_id" string="الشعبة" domain="[('course_id', '=', course_id)]" required="1"/>
                                        <field name="roll_number" string="رقم الجلوس" optional="show"/>
                                        <field name="academic_years_id" string="العام الدراسي" optional="show"/>
                                        <field name="academic_term_id" string="الفصل الدراسي" optional="show"/>
                                        <field name="subject_ids" string="المواد الدراسية" widget="many2many_tags" optional="hide"/>
                                        <field name="state" string="حالة القيد" widget="badge" decoration-info="state == 'running'" decoration-success="state == 'finished'"/>
                                    </list>
                                </field>
                            </page>
                            <page string="العنوان والاتصال" name="address_info">
                                <group>
                                    <group string="العنوان الوطني">
                                        <label for="street" string="العنوان الوطني"/>
                                        <div name="o_address_format">
                                            <field name="street" placeholder="اسم الشارع والحي..."/>
                                            <field name="street2" placeholder="تفاصيل إضافية للعنوان..."/>
                                            <div class="address_format d-md-flex">
                                                <field name="city" placeholder="المدينة" />
                                                <field name="state_id" class="oe_no_button" placeholder="المنطقة / الإمارة"
                                                         options="{'no_open': True}"/>
                                                <field name="zip" placeholder="الرمز البريدي" />
                                            </div>
                                            <field name="country_id" placeholder="الدولة" class="oe_no_button"
                                                    options="{'no_open': True}"/>
                                        </div>
                                    </group>
                                    <group string="جهة الاتصال في حالات الطوارئ">
                                        <field name="emergency_contact" string="جهة الاتصال للطوارئ" context="{'show_address': 1}"
                                                options="{'always_reload': True}"/>
                                    </group>
                                </group>
                            </page>
                            <page string="معلومات إضافية ومرفقات" name="other_information">
                                <group name="other_info">
                                    <field name="child_ids" mode="kanban" context="{'default_parent_id': id, 'default_street': street, 'default_street2': street2, 'default_city': city, 'default_state_id': state_id, 'default_zip': zip, 'default_country_id': country_id, 'default_lang': lang, 'default_user_id': user_id, 'default_type': is_company and 'contact' or 'other'}">
                                        <kanban color="color">
                                            <field name="color"/>
                                            <field name="type"/>
                                            <field name="is_company"/>
                                            <templates>
                                                <t t-name="card" class="flex-row">
                                                    <aside class="o_kanban_aside_full">
                                                        <field name="avatar_128" class="o_kanban_image_fill w-100" widget="image" options="{'img_class': 'object-fit-cover'}" alt="Contact image" invisible="type != 'contact'"/>
                                                        <field name="avatar_128" class="o_kanban_image_fill w-100" widget="image" options="{'img_class': 'object-fit-contain p-2'}" alt="Contact image" invisible="type == 'contact'"/>
                                                    </aside>
                                                    <main class="ps-2 ps-md-0">
                                                        <field name="name" invisible="not name" class="fw-bold"/>
                                                        <field name="type" invisible="name" class="fw-bold"/>
                                                        <div t-if="record.email.raw_value" class="text-truncate">
                                                            <i class="fa fa-fw me-1 fa-envelope text-primary" title="Email"/>
                                                            <field name="email"/>
                                                        </div>
                                                        <div t-if="record.phone.raw_value">
                                                            <i class="fa fa-fw me-1 fa-phone text-primary" title="Phone"/>
                                                            <field name="phone"/>
                                                        </div>
                                                        <div invisible="not function or is_company">
                                                            <i class="fa fa-fw me-1 fa-suitcase text-primary" title="Position"/>
                                                            <field name="function"/>
                                                        </div>
                                                        <div t-if="record.type.raw_value != 'contact' and (record.city.raw_value or record.country_id.raw_value)">
                                                            <i class="fa fa-fw me-1 fa-map-marker text-primary" title="Location"/>
                                                            <field name="city"/>
                                                            <span t-if="record.city.raw_value and record.country_id.raw_value">, </span>
                                                            <field name="country_id"/>
                                                        </div>
                                                    </main>
                                                </t>
                                            </templates>
                                        </kanban>
                                        <form string="Contact / Address">
                                            <sheet>
                                                <field name="type" required="1" widget="radio" options="{'horizontal': true}"/>
                                                <div class="d-flex align-items-center gap-3">
                                                    <field name="image_1920" widget="contact_image" nolabel="1" options="{'preview_image': 'avatar_128', 'size': [100,100], 'img_class': 'rounded border'}"/>
                                                    <div class="flex-grow-1">
                                                        <h3>
                                                            <field name="name" class="d-block" string="Name" default_focus="1" required="type == 'contact'" placeholder="e.g. Brandon Freeman"/>
                                                        </h3>
                                                        <div class="row flex-row">
                                                            <div class="d-flex align-items-baseline">
                                                                <i class="fa fa-fw me-1 fa-envelope text-primary" title="البريد الإلكتروني"/>
                                                                <field name="email" widget="email" class="w-100" context="{'gravatar_image': True}" required="user_ids" placeholder="البريد الإلكتروني"/>
                                                            </div>
                                                            <div class="d-flex align-items-baseline">
                                                                <i class="fa fa-fw me-1 fa-phone text-primary" title="رقم الهاتف"/>
                                                                <field name="phone" widget="phone" class="w-100" placeholder="رقم الهاتف"/>
                                                            </div>
                                                            <div invisible="is_company or type != 'contact'" class="d-flex align-items-baseline">
                                                                <i class="fa fa-fw me-1 fa-suitcase text-primary" title="الصفة / المسمى"/>
                                                                <field name="function" placeholder="المسمى الوظيفي أو صلة القرابة"/>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <group invisible="type == 'contact'" name="other_info">
                                                    <group>
                                                        <span class="o_form_label o_td_label o_address_type">
                                                            <field name="type_address_label" readonly="1" class="fw-bold"/>
                                                        </span>
                                                        <div class="o_address_format" name="div_address">
                                                            <field name="street" placeholder="اسم الشارع والحي..." class="o_address_street"/>
                                                            <field name="street2" placeholder="العنوان الإضافي..." class="o_address_street"/>
                                                            <field name="city" placeholder="المدينة" class="o_address_city"/>
                                                            <field name="state_id" class="o_address_state" placeholder="المنطقة / المحافظة" options="{'no_open': True, 'no_quick_create': True}" context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>
                                                            <field name="zip" placeholder="الرمز البريدي" class="o_address_zip"/>
                                                            <field name="country_id" placeholder="الدولة" class="o_address_country" options='{"no_open": True, "no_create": True}'/>
                                                        </div>
                                                    </group>
                                                </group>
                                                <group>
                                                    <field name="company_id" invisible="1"/>    <!-- Need to save value from parented record, cf onchange -->
                                                    <label for="comment"/>
                                                    <field name="comment" options="{'height': 100}" placeholder="ملاحظات داخلية إضافية..." nolabel="1"/>
                                                </group>
                                                <field name="lang" invisible="True"/>  <!-- Need to add lang to save default value from parented record -->
                                            </sheet>
                                        </form>
                                    </field>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_op_student_search" model="ir.ui.view">
            <field name="name">op.student.search</field>
            <field name="model">op.student</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <search string="بحث الطلاب">
                    <field name="name" string="اسم الطالب" filter_domain="['|','|',('name','ilike',self),('email','ilike',self),('phone','ilike',self)]"/>
                    <field name="gr_no"/>
                    <field name="course_detail_ids" string="المرحلة / الصف" filter_domain="[('course_detail_ids.course_id.name', 'ilike', self)]"/>
                    <field name="id_type"/>
                    <field name="id_number"/>
                    <field name="gender"/>
                    <field name="nationality"/>
                    <field name="blood_group"/>
                    <field name="category_id"/>
                    <separator/>
                    <filter name="male" string="ذكور" domain="[('gender', '=', 'm')]"/>
                    <filter name="female" string="إناث" domain="[('gender', '=', 'f')]"/>
                    <separator/>
                    <filter name="national_id_filter" string="هوية وطنية" domain="[('id_type', '=', 'national_id')]"/>
                    <filter name="iqama_filter" string="إقامة نظامية" domain="[('id_type', '=', 'iqama')]"/>
                    <filter name="passport_filter" string="جواز سفر" domain="[('id_type', '=', 'passport')]"/>
                    <separator/>
                    <filter name="filter_enrolled" string="منتظم / مقيد حالياً" domain="[('course_detail_ids', '!=', False)]"/>
                    <separator/>
                    <filter name="filter_registration_date" string="تاريخ التسجيل" date="create_date"/>
                    <filter name="filter_birth_date" string="تاريخ الميلاد" date="birth_date"/>
                    <separator/>
                    <filter string="مؤرشف" name="inactive" domain="[('active', '=', False)]"/>
                    <newline/>
                    <group>
                        <filter name="gender" string="الجنس"
                                domain="[]" context="{'group_by':'gender'}"/>
                        <filter name="group_id_type" string="نوع الوثيقة"
                                domain="[]" context="{'group_by':'id_type'}"/>
                        <filter name="blood_group" string="فصيلة الدم"
                                domain="[]" context="{'group_by':'blood_group'}"/>
                        <filter name="nationality" string="الجنسية"
                                domain="[]" context="{'group_by':'nationality'}"/>
                        <filter name="language" string="اللغة"
                                domain="[]" context="{'group_by':'lang'}"/>
                        <filter name="category" string="فئة الطالب"
                                domain="[]" context="{'group_by':'category_id'}"/>
                    </group>
                    <searchpanel>
                        <field name="gender" icon="fa-venus-mars" enable_counters="1"/>
                        <field name="id_type" icon="fa-id-card-o" enable_counters="1"/>
                        <field name="category_id" icon="fa-users" enable_counters="1"/>
                    </searchpanel>
                </search>
            </field>
        </record>

        <record id="student_view_activity" model="ir.ui.view">
            <field name="name">op.students.activity</field>
            <field name="model">op.student</field>
            <field name="arch" type="xml">
                <activity string="أنشطة الطلاب">
                    <field name="id"/>
                    <templates>
                        <div t-name="activity-box">
                            <img t-att-src="activity_image('op.student', 'image_1920', record.id.raw_value)" role="img" t-att-title="record.name.value" t-att-alt="record.name.value"/>
                            <div class="ms-2">
                                <field name="name" display="full" class="o_text_block"/>
                            </div>
                        </div>
                    </templates>
                </activity>
            </field>
        </record>

        <record model="ir.actions.act_window" id="act_open_op_student_view">
            <field name="name">الطلاب</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">op.student</field>
            <field name="path">students</field>
            <field name="binding_view_types">form</field>
            <field name="view_mode">kanban,list,form,activity</field>
            <field name="search_view_id" ref="view_op_student_search"/>
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_op_student_view_form">
            <field name="act_window_id" ref="act_open_op_student_view"/>
            <field name="sequence" eval="20"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_op_student_form"/>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_op_student_view_tree">
            <field name="act_window_id" ref="act_open_op_student_view"/>
            <field name="sequence" eval="10"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_op_student_tree"/>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_op_student_view_kanban">
            <field name="act_window_id" ref="act_open_op_student_view"/>
            <field name="sequence" eval="5"/>
            <field name="view_mode">kanban</field>
            <field name="view_id" ref="kanban_view_student"/>
        </record>

        <record model="ir.actions.act_window" id="act_open_op_student_view_2">
            <field name="name">الطلاب</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">op.student</field>
            <field name="path">student</field>
            <field name="binding_view_types">form</field>
            <field name="view_mode">kanban,list,form,activity</field>
            <field name="search_view_id" ref="view_op_student_search"/>
