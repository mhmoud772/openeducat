<odoo>

        <record id="op_student_user_create_view" model="ir.ui.view">
            <field name="name">wizard.op.student.form</field>
            <field name="model">wizard.op.student</field>
            <field name="arch" type="xml">
                <form string="إنشاء حسابات المستخدمين">
                    <p class="oe_grey">إنشاء حسابات دخول إلكترونية للطلاب المحددين على النظام</p>
                    <separator string="الطلاب المشمولون" colspan="4"/>
                    <field name="student_ids" widget="many2many_tags" readonly="1"/>
                    <footer>
                        <button string="تأكيد إنشاء الحسابات" name="create_user" type="object" default_focus="1"
                                class="oe_highlight"/>
                        <button string="إلغاء" class="btn-secondary ms-1" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="student_user_create_view_act">
            <field name="name">إنشاء حسابات مستخدمين</field>
            <field name="res_model">wizard.op.student</field>
            <field name="binding_view_types">list,form</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="model_op_student"/>
        </record>


</odoo>
