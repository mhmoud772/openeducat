<odoo>

        <record id="op_faculty_user_create_view" model="ir.ui.view">
            <field name="name">wizard.op.faculty.form</field>
            <field name="model">wizard.op.faculty</field>
            <field name="arch" type="xml">
                <form string="إنشاء حسابات مستخدمين للمعلمين">
                    <p class="oe_grey">إنشاء حسابات دخول إلكترونية للمعلمين المحددين على النظام</p>
                    <separator string="المعلمون المشمولون" colspan="4"/>
                    <field name="faculty_ids" widget="many2many_tags" readonly="1"/>
                    <footer>
                        <button string="تأكيد إنشاء الحسابات" name="create_faculty_user" type="object" default_focus="1"
                                class="oe_highlight"/>
                        <button string="إلغاء" class="btn-secondary ms-1" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="faculty_user_create_view_act">
            <field name="name">إنشاء حسابات مستخدمين</field>
            <field name="res_model">wizard.op.faculty</field>
            <field name="binding_view_types">list,form</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="model_op_faculty"/>
        </record>

</odoo>
