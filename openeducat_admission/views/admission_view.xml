<?xml version="1.0" encoding="UTF-8"?>
<odoo>
        <record id="view_op_admission_tree" model="ir.ui.view">
            <field name="name">op.admission.list</field>
            <field name="model">op.admission</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <list string="طلبات القبول والتسجيل">
                    <field name="application_number" string="رقم الطلب"/>
                    <field name="title" string="اللقب" optional="show"/>
                    <field name="name" string="اسم الطالب الرباعي"/>
                    <field name="admission_date" string="تاريخ القبول"/>
                    <field name="application_date" string="تاريخ التقديم"/>
                    <field name="course_id" string="المرحلة / الصف"/>
                    <field name="batch_id" string="الشعبة / الفصل" optional="hide"/>
                    <field name="state"
                           string="حالة الطلب"
                           widget="badge"
                           decoration-muted="state in ('draft')"
                           decoration-success="state in ('done','confirm')"
                           decoration-primary="state in ('submit','admission','pending')"
                           decoration-danger="state in ('cancel')"
                           optional="show"/>
                    <field name="company_id" string="المدرسة / الفرع" groups="base.group_multi_company" optional="show"/>
                    <field name="gender" string="الجنس" optional="hide"/>
                    <field name="birth_date" string="تاريخ الميلاد" optional="hide"/>
                    <field name="email" string="البريد الإلكتروني" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_op_admission_form" model="ir.ui.view">
            <field name="name">op.admission.form</field>
            <field name="model">op.admission</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <form string="طلب تسجيل وقبول طالب">
                    <header>
                        <button string="إرسال الطلب للتدقيق" invisible="state != 'draft'"
                                class="oe_highlight" type="object"
                                name="submit_form"/>
                        <button name="confirm_in_progress"
                                invisible="state not in ('submit','pending')"
                                string="تأكيد ومراجعة المستندات" type="object"
                                class="oe_highlight"/>
                        <button string="اعتماد القبول المبدئي" class="oe_highlight"
                                invisible="state != 'confirm'"
                                type="object"
                                name="admission_confirm"/>
                        <button name="enroll_student" invisible="state != 'admission'"
                                string="تسجيل كطالب رسمي (إصدار الرقم الأكاديمي)" type="object"
                                class="oe_highlight"/>
                        <button name="confirm_rejected"
                                invisible="state not in ('confirm','confirm_pending')"
                                string="رفض الطلب" type="object"/>
                        <button name="confirm_pending" invisible="state != 'submit'"
                                string="وضع قيد الانتظار" type="object"/>
                        <button name="confirm_cancel" string="إلغاء الطلب" type="object"/>
                        <button name="confirm_to_draft"
                                invisible="state not in ('pending','reject','cancel')"
                                string="إعادة كمسودة"
                                type="object"/>
                        <button name="open_student" invisible="state != 'done'"
                                string="فتح الملف الأكاديمي للطالب"
                                type="object"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,confirm,done"/>
                    </header>
                    <sheet>
                        <field name="active" invisible="True"/>
                        <widget name="web_ribbon" title="مؤرشف" bg_color="bg-danger"
                                invisible="active == True"/>

                        <div class="row flex-column flex-sm-row align-items-center">
                            <div class="d-md-flex">
                                <div class="o_employee_avatar ms-2 p-0 h-100 mw-25 align-self-start align-self-sm-center">
                                    <field name="image" widget='image' class="m-0" options='{"size": [128,158], "zoom": true}' />
                                </div>
                                <div class="align-self-start o_employee_form_header_info ps-md-3">
                                    <div class="oe_title ps-0 pe-2 mw-100">
                                        <h5 class="d-flex align-items-baseline mb-0">
                                            <field name="title" options="{'no_create': True}" placeholder="اللقب"/>
                                        </h5>
                                        <div class="d-flex student-name">
                                            <div>
                                                <h1 class="d-md-flex align-items-center gap-1 w-100">
                                                    <field name="name" placeholder="الاسم الكامل" required="1" invisible="True"/>
                                                    <field name="first_name" widget="inline_char" required="1" placeholder="الاسم الأول"/>
                                                    <field name="middle_name" widget="inline_char" placeholder="اسم الأب"/>
                                                    <field name="third_name" widget="inline_char" placeholder="اسم الجد"/>
                                                    <field name="last_name" widget="inline_char" placeholder="العائلة / القبيلة"/>
                                                </h1>
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-baseline">
                                            <i class="fa fa-fw me-1 fa-envelope text-primary" title="البريد الإلكتروني"/>
                                            <field name="email" class="w-100" widget="email" placeholder="البريد الإلكتروني"/>
                                        </div>
                                        <div class="d-flex align-items-baseline">
                                            <i class="fa fa-fw me-1 fa-phone text-primary" title="رقم الهاتف"/>
                                            <field name="phone" class="w-100" widget="phone" placeholder="رقم الهاتف للتواصل"/>
                                        </div>

                                    </div>
                               </div>
                            </div>
                        </div>

                        <notebook>
                            <page name="admission_detail" string="بيانات القبول والرسوم">
                                <group>
                                    <group string="المعلومات الأكاديمية">
                                        <field name="register_id"
                                               string="فترة القبول"
                                               readonly="state == 'done'"
                                               domain="[('state', 'in', ['application','admission'])]"
                                               widget="selection"/>
                                        <field name="application_date"
                                               string="تاريخ التقديم"
                                               readonly="state == 'done'"/>
                                        <field name="course_ids" invisible="True"/>
                                        <field name="course_id"
                                               string="المرحلة / الصف الدراسي"
                                               readonly="state == 'done'"
                                               domain="[('id', 'in', course_ids)]"
                                               options="{'no_open': True, 'no_create': True}"/>
                                        <field name="batch_id"
                                               string="الشعبة / الفصل"
                                               context="{'course_id': course_id,'get_parent_batch':1}"
                                               readonly="state == 'done'"
                                               required="1"/>
                                        <field name="is_student" string="طالب حالي مسجل مسبقاً"/>
                                        <field name="student_id" string="ملف الطالب الحالي" placeholder="اختر الطالب"
                                               readonly="state == 'done'"
                                               options="{'no_create_edit': True}"
                                               required="is_student == True"
                                               invisible="is_student == False"/>
                                        <field name="company_id"
                                               string="المدرسة"
                                               groups="base.group_multi_company"
                                               optional="show"/>
                                    </group>
                                    <group string="الرسوم المالية وجدولة الأقساط">
                                        <field name="application_number" string="رقم طلب الالتحاق"/>
                                        <field name="admission_date"
                                               string="تاريخ القبول الرسمي"
                                               readonly="state == 'done'"/>
                                        <field name="fees" string="إجمالي الرسوم الدراسية" readonly="state == 'done'"
                                               required="state not in ('draft', 'submit')"/>
                                        <field name="discount" string="نسبة الخصم / المنحة (%)"/>
                                        <field name="due_date"
                                               string="تاريخ استحقاق الرسوم"
                                               readonly="state == 'done'"/>
                                        <field name="fees_term_id" string="خطة سداد الرسوم" required="1"
                                               readonly="state not in ('draft', 'submit', 'confirm')"/>
                                        <field name="fees_start_date" string="تاريخ بدء سداد الأقساط"/>
                                        <field name="partner_id" string="جهة الاتصال الشريكة (ولي الأمر)"/>
                                    </group>
                                </group>
                            </page>
                            <page name="educational_detail"
                                  string="المؤهلات والدراسة السابقة">
                                <group>
                                    <group string="المدرسة السابقة">
                                        <field name="prev_institute_id"
                                               string="المدرسة / المؤسسة السابقة"
                                               readonly="state == 'done'"/>
                                        <field name="prev_result"
                                               string="المعدل / النتيجة السابقة"
                                               readonly="state == 'done'"/>
                                    </group>
                                    <group string="المرحلة السابقة">
                                        <field name="prev_course_id"
                                               string="الصف / المرحلة السابقة"
                                               readonly="state == 'done'"/>
                                    </group>
                                </group>
                            </page>
                            <page name="personal_detail" string="البيانات الشخصية والعنوان الوطني">
                                <group>
                                    <group string="بيانات الهوية الوطنية والإقامة">
                                        <field name="id_type" string="نوع الوثيقة" required="1"/>
                                        <field name="id_number" string="رقم بطاقة الهوية / الإقامة" placeholder="مثال: 10XXXXXXXX أو 20XXXXXXXX"/>
                                        <field name="id_issue_place" string="مكان الإصدار" placeholder="المدينة / المنطقة"/>
                                        <field name="id_issue_date" string="تاريخ إصدار الهوية"/>
                                        <field name="id_expiry_date" string="تاريخ انتهاء الهوية"/>
                                    </group>
                                    <group string="البيانات الأساسية">
                                        <field name="gender" string="الجنس" required="1"/>
                                        <field name="birth_date"
                                               string="تاريخ الميلاد"
                                               options="{'datepicker':{'warn_future': true}}"
                                               readonly="state == 'done'"/>
                                        <field name="family_income"
                                               string="الدخل العائلي"
                                               readonly="state == 'done'"/>
                                        <field name="family_business"
                                               string="مجال عمل الأسرة"
                                               readonly="state == 'done'"/>
                                        <field name="nbr" invisible="True"/>
                                    </group>
                                </group>
                                <group string="العنوان الوطني">
                                    <label for="street" string="العنوان الوطني"/>
                                    <div name="o_address_format">
                                        <field name="street" placeholder="اسم الشارع ورقم المبنى..."/>
                                        <field name="street2" placeholder="الحي / الرمز الإضافي..."/>
                                        <div class="address_format d-md-flex">
                                            <field name="city" placeholder="المدينة" />
                                            <field name="state_id" class="oe_no_button" placeholder="المنطقة / الإمارة"
                                                     options="{&quot;no_open&quot;: True}"/>
                                            <field name="zip" placeholder="الرمز البريدي" />
                                        </div>
                                        <field name="country_id" placeholder="الدولة" class="oe_no_button"
                                                options="{&quot;no_open&quot;: True}"/>
                                    </div>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_op_admission_search" model="ir.ui.view">
            <field name="name">op.admission.search</field>
            <field name="model">op.admission</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <search string="البحث في طلبات القبول">
                    <field name="name" string="اسم الطالب"/>
                    <field name="application_number" string="رقم الطلب"/>
                    <field name="admission_date" string="تاريخ القبول"/>
                    <field name="application_date" string="تاريخ التقديم"/>
                    <field name="birth_date" string="تاريخ الميلاد"/>
                    <field name="course_id" string="المرحلة / الصف"/>
                    <field name="batch_id" string="الشعبة / الفصل"/>
                    <separator/>
                    <filter name="enrolled_student" string="الطلاب المقيدون رسمياً"
                            domain="[('state','=','done')]"/>
                    <filter name="pending_student" string="طلبات قيد الانتظار"
                            domain="[('state','=','pending')]"/>
                    <group>
                        <filter string="تاريخ القبول"
                                name="group_by_adm_admission_date"
                                domain="[]" context="{'group_by':'admission_date'}"/>
                        <filter string="تاريخ التقديم"
                                name="group_by_adm_application_date"
                                domain="[]" context="{'group_by':'application_date'}"/>
                        <filter string="المرحلة الدراسية" name="group_by_adm_course_id"
                                domain="[]" context="{'group_by':'course_id'}"/>
                        <filter string="الشعبة" name="group_by_adm_batch_id"
                                domain="[]" context="{'group_by':'batch_id'}"/>
                        <filter string="حالة الطلب" name="group_by_adm_state"
                                domain="[]" context="{'group_by':'state'}"/>
                        <filter string="فترة القبول" name="group_by_adm_register"
                                domain="[('register_id.state', 'not in', ['cancel', 'done'])]"
                                context="{'group_by':'register_id'}"/>
                        <filter string="المؤرشفة" name="inactive"
                                domain="[('active', '=', False)]"/>
                    </group>
                </search>
            </field>
        </record>

        <record model="ir.ui.view" id="view_op_admission_graph">
            <field name="name">op.admission.graph</field>
            <field name="model">op.admission</field>
            <field name="arch" type="xml">
                <graph string="القبول حسب المرحلة" type="pie">
                    <field name="course_id"/>
                    <field name="nbr" operator="+"/>
                </graph>
            </field>
        </record>

        <record model="ir.ui.view" id="view_op_admission_pivot">
            <field name="name">op.admission.pivot</field>
            <field name="model">op.admission</field>
            <field name="arch" type="xml">
                <pivot string="القبول حسب المرحلة والصفوف">
                    <field name="title"/>
                    <field name="name"/>
                    <field name="middle_name"/>
                    <field name="last_name"/>
                    <field name="application_number"/>
                    <field name="register_id"/>
                    <field name="admission_date"/>
                    <field name="application_date"/>
                    <field name="birth_date"/>
                    <field name="course_id" type="row"/>
                    <field name="batch_id"/>
                    <field name="state"/>
                </pivot>
            </field>
        </record>

        <record model="ir.actions.act_window" id="act_open_op_admission_view">
            <field name="name">طلبات الالتحاق والقبول</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">op.admission</field>
            <field name="path">admission</field>
            <field name="binding_view_types">form</field>
            <field name="view_mode">list,form,graph,pivot</field>
            <field name="search_view_id" ref="view_op_admission_search"/>
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>

        <record model="ir.actions.act_window.view"
                id="act_open_op_admission_view_form">
            <field name="act_window_id" ref="act_open_op_admission_view"/>
            <field name="sequence" eval="20"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_op_admission_form"/>
        </record>

        <record model="ir.actions.act_window.view"
                id="act_open_op_admission_view_tree">
            <field name="act_window_id" ref="act_open_op_admission_view"/>
            <field name="sequence" eval="10"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_op_admission_tree"/>
        </record>

        <record id="view_op_student_course_form_admission_inherit" model="ir.ui.view">
            <field name="name">op.student.course.form.admission.inherit</field>
            <field name="model">op.student.course</field>
            <field name="inherit_id"
                   ref="openeducat_core.view_op_student_course_form"/>
            <field name="arch" type="xml">
                <field name="fees_term_id" position="before">
                    <field name="product_id" string="بند الرسوم الدراسية" required="1"/>
                </field>
            </field>
        </record>

    <record id="res_config_settings_view_user" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.admission</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="40"/>
        <field name="inherit_id"
               ref="openeducat_core.res_config_settings_view_form_core"/>
        <field name="arch" type="xml">
            <xpath expr="//div[contains(@invisible, 'module_openeducat_admission')]/div[1]"
                   position="inside">
                <div class="col-12 col-md-1 col-lg-6 mb16">
                    <div class="o_setting_left_pane">
                        <field
                                name="enable_create_student_user"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label
                                for="enable_create_student_user" string="إنشاء حساب مستخدم للطالب تلقائياً"/>
                                <span class="fa fa-info-circle" title="سمارت إديو للأنظمة التعليمية"/>
                        <div class="text-muted">تفعيل هذا الخيار لإنشاء حساب مستخدم وبوابة للطالب عند اعتماد القبول
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
