<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_report_fees_detail_analysis" model="ir.actions.report">
        <field name="name">Fees Details Report</field>
        <field name="model">op.student</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">openeducat_fees.report_fees_analysis</field>
        <field name="report_file">openeducat_fees.report_fees_analysis</field>
        <field name="paperformat_id" eval="False"/>
    </record>

    <record id="action_report_student_fee_receipt" model="ir.actions.report">
        <field name="name">سند استلام رسوم (Fee Receipt)</field>
        <field name="model">op.student.fees.details</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">openeducat_fees.report_fee_receipt</field>
        <field name="report_file">openeducat_fees.report_fee_receipt</field>
        <field name="print_report_name">'سند استلام رسوم - %s' % (object.student_id.name)</field>
        <field name="binding_model_id" ref="openeducat_fees.model_op_student_fees_details"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
