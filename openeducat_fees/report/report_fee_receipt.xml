<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_fee_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="page" style="direction: rtl; font-family: 'Cairo', 'Tajawal', 'Segoe UI', Tahoma, sans-serif; padding: 20px 25px; color: #0F172A;">
                    <style>
                        .smartedu-receipt-box {
                            border: 2px solid #1E3A8A;
                            border-radius: 14px;
                            padding: 24px;
                            background: #FFFFFF;
                            box-shadow: 0 4px 15px rgba(10, 25, 47, 0.08);
                            position: relative;
                        }
                        .smartedu-receipt-header {
                            display: flex;
                            align-items: center;
                            justify-content: space-between;
                            border-bottom: 2.5px solid #D97706;
                            padding-bottom: 16px;
                            margin-bottom: 20px;
                        }
                        .smartedu-receipt-title {
                            text-align: center;
                            margin: 15px 0 22px 0;
                        }
                        .smartedu-receipt-badge {
                            display: inline-block;
                            font-size: 20px;
                            font-weight: 900;
                            color: #FFFFFF;
                            background: linear-gradient(135deg, #0A192F 0%, #1E3A8A 100%);
                            padding: 6px 30px;
                            border-radius: 20px;
                            border: 1.5px solid #D97706;
                            letter-spacing: 0.5px;
                        }
                        .smartedu-info-grid {
                            background: #F8FAFC;
                            border: 1px solid #E2E8F0;
                            border-radius: 10px;
                            padding: 14px 18px;
                            margin-bottom: 22px;
                            font-size: 13.5px;
                            line-height: 1.8;
                        }
                        .smartedu-table {
                            width: 100%;
                            border-collapse: collapse;
                            margin: 16px 0;
                            font-size: 13px;
                        }
                        .smartedu-table th {
                            background: linear-gradient(135deg, #0A192F 0%, #1E3A8A 100%);
                            color: #FFFFFF;
                            padding: 10px 12px;
                            text-align: center;
                            font-weight: 700;
                            border: 1px solid #1E3A8A;
                        }
                        .smartedu-table td {
                            padding: 10px 12px;
                            border: 1px solid #E2E8F0;
                            text-align: center;
                        }
                        .smartedu-total-banner {
                            background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);
                            border: 1.5px solid #93C5FD;
                            border-radius: 10px;
                            padding: 14px 20px;
                            display: flex;
                            align-items: center;
                            justify-content: space-between;
                            margin: 20px 0;
                        }
                    </style>

                    <div class="smartedu-receipt-box">
                        <!-- ترويسة السند -->
                        <div class="smartedu-receipt-header">
                            <div style="text-align: right; font-size: 13px; line-height: 1.6; font-weight: 700; color: #1E3A8A;">
                                <div>الإدارة المالية والحسابات</div>
                                <div style="font-size: 16px; color: #0A192F; font-weight: 800;"><t t-out="o.company_id.name or res_company.name or 'سمارت إديو للأنظمة التعليمية'"/></div>
                                <div style="color: #64748B; font-size: 11px;">الرقم الضريبي: <t t-out="res_company.vat or '300000000000003'"/></div>
                            </div>

                            <div style="text-align: center;">
                                <img t-if="res_company.logo" t-att-src="image_data_uri(res_company.logo)"
                                     style="max-height: 65px; max-width: 120px; object-fit: contain; margin-bottom: 4px;"/>
                            </div>

                            <div style="text-align: left; font-size: 12px; line-height: 1.6; color: #475569;">
                                <div><strong>رقم السند:</strong> <span style="color: #1E3A8A; font-weight: 800;"><t t-out="'REC-' + str(o.id).zfill(6)"/></span></div>
                                <div><strong>تاريخ السند:</strong> <span t-esc="o.date or time.strftime('%Y-%m-%d')" t-options="{'widget':'date'}"/></div>
                                <div><strong>رقم الفاتورة:</strong> <span style="font-weight: 700;"><t t-out="o.invoice_id.name or '—'"/></span></div>
                            </div>
                        </div>

                        <!-- عنوان السند -->
                        <div class="smartedu-receipt-title">
                            <div class="smartedu-receipt-badge">
                                سند استلام رسوم دراسية (سند قبض)
                            </div>
                            <div style="color: #64748B; font-size: 11px; margin-top: 4px; font-weight: 600;">
                                OFFICIAL PAYMENT RECEIPT
                            </div>
                        </div>

                        <!-- شبكة بيانات الطالب -->
                        <div class="smartedu-info-grid">
                            <div class="row">
                                <div class="col-6 mb-2">
                                    <span style="color: #64748B;">• اسم الطالب: </span>
                                    <strong style="color: #0A192F; font-size: 14.5px;"><t t-out="o.student_id.name"/></strong>
                                </div>
                                <div class="col-6 mb-2">
                                    <span style="color: #64748B;">• رقم القيد: </span>
                                    <strong><t t-out="o.student_id.gr_no or '—'"/></strong>
                                </div>
                                <div class="col-6 mb-2">
                                    <span style="color: #64748B;">• الهوية / الإقامة: </span>
                                    <strong style="color: #1E3A8A;"><t t-out="o.student_id.id_number or '—'"/></strong>
                                </div>
                                <div class="col-6 mb-2">
                                    <span style="color: #64748B;">• المرحلة والصف: </span>
                                    <strong style="color: #D97706;">
                                        <t t-if="o.course_id"><t t-out="o.course_id.name"/></t>
                                        <t t-elif="o.student_id.course_detail_ids"><t t-out="o.student_id.course_detail_ids[0].course_id.name"/></t>
                                        <t t-else="">—</t>
                                    </strong>
                                </div>
                                <div class="col-6">
                                    <span style="color: #64748B;">• الشعبة: </span>
                                    <strong>
                                        <t t-if="o.batch_id"><t t-out="o.batch_id.name"/></t>
                                        <t t-elif="o.student_id.course_detail_ids and o.student_id.course_detail_ids[0].batch_id"><t t-out="o.student_id.course_detail_ids[0].batch_id.name"/></t>
                                        <t t-else="">—</t>
                                    </strong>
                                </div>
                                <div class="col-6">
                                    <span style="color: #64748B;">• حالة السند: </span>
                                    <span style="background: #10B981; color: white; padding: 2px 10px; border-radius: 4px; font-size: 11px; font-weight: 700;">
                                        مُسدد / معتمد
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- جدول تفاصيل المبالغ -->
                        <table class="smartedu-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>بيان الرسوم الدراسية</th>
                                    <th>المبلغ الأساسي</th>
                                    <th>نسبة الخصم</th>
                                    <th>المبلغ المستلم بعد الخصم</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>1</td>
                                    <td style="text-align: right; font-weight: 700;">
                                        <t t-out="o.product_id.name or (o.fees_line_id and o.fees_line_id.name) or 'قسط دراسي معتمد'"/>
                                    </td>
                                    <td>
                                        <t t-out="o.amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                    </td>
                                    <td>
                                        <t t-if="o.discount">
                                            <span style="color: #DC2626; font-weight: 700;"><t t-out="o.discount"/>%</span>
                                        </t>
                                        <t t-else="">0%</t>
                                    </td>
                                    <td style="font-weight: 800; color: #1E3A8A; font-size: 14px;">
                                        <t t-out="o.after_discount_amount or o.amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- إجمالي المبلغ -->
                        <div class="smartedu-total-banner">
                            <div>
                                <span style="font-size: 13px; color: #1E3A8A; font-weight: 700;">إجمالي المبلغ المستلم:</span>
                                <div style="font-size: 12px; color: #64748B; margin-top: 2px;">
                                    فقط وقدره: <strong style="color: #0A192F;"><t t-out="o.after_discount_amount or o.amount"/> <t t-out="o.currency_id.symbol or 'ر.س'"/> لا غير</strong>
                                </div>
                            </div>
                            <div style="font-size: 20px; font-weight: 900; color: #0A192F;">
                                <t t-out="o.after_discount_amount or o.amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                            </div>
                        </div>

                        <!-- التوقيعات والختم المالي والـ QR -->
                        <div style="margin-top: 35px; padding-top: 15px; border-top: 1px solid #E2E8F0;">
                            <div class="row align-items-center">
                                <div class="col-4 text-center">
                                    <div style="font-weight: 700; font-size: 13px; color: #1E3A8A; margin-bottom: 30px;">المستلم / أمين الصندوق</div>
                                    <div style="font-size: 12px; color: #475569;">التوقيع: ............................</div>
                                </div>
                                <div class="col-4 text-center">
                                    <t t-set="receipt_qr" t-value="'SMARTEDU-REC:' + str(o.id) + ':' + (o.student_id.name or '') + ':' + str(o.after_discount_amount or o.amount)"/>
                                    <img t-att-src="env['ir.actions.report'].get_barcode_data_uri('QR', receipt_qr, width=70, height=70)"
                                         style="width: 70px; height: 70px; border: 1px solid #CBD5E1; border-radius: 6px; padding: 2px; background: white; margin-bottom: 2px;"/>
                                    <div style="font-size: 9px; color: #64748B; font-weight: 700;">رمز التحقق المالي</div>
                                </div>
                                <div class="col-4 text-center">
                                    <div style="font-weight: 700; font-size: 13px; color: #1E3A8A; margin-bottom: 30px;">المحاسب المالي والختم</div>
                                    <div style="font-size: 12px; color: #475569;">التوقيع: ............................</div>
                                </div>
                            </div>
                        </div>

                        <!-- تذييل السند -->
                        <div style="text-align: center; font-size: 9px; color: #94A3B8; margin-top: 25px; border-top: 1px solid #F1F5F9; padding-top: 6px;">
                            سند مالي رسمي صادر من نظام سمارت إديو المحاسبي • يرجى الاحتفاظ بهذا الإيصال للمراجعة
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
