<?xml version="1.0" encoding="UTF-8"?>
<odoo>

        <record id="view_fees_terms_tree" model="ir.ui.view">
            <field name="name">op.fees.terms.list</field>
            <field name="model">op.fees.terms</field>
            <field name="type">list</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <list string="خطط وجداول الرسوم الدراسية" js_class="fees_wizard_list">
                    <field name="name" string="مسمى الخطة"/>
                    <field name="code" string="الرمز"/>
                    <field name="fees_terms" string="نوع السداد"/>
                    <field name="discount" string="الخصم المسموح (%)"/>
                    <field name="active" string="نشط" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="view_fees_terms_form" model="ir.ui.view">
            <field name="name">op.fees.terms.form</field>
            <field name="model">op.fees.terms</field>
            <field name="type">form</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <form string="خطة الرسوم والأقساط">
                    <header/>
                    <sheet>
                        <field name="active" invisible="True"/>
                        <widget name="web_ribbon" title="مؤرشف" bg_color="bg-danger"
                                invisible="active == True"/>
                        <div class="oe_title">
                            <label for="name" string="مسمى خطة الرسوم"/>
                            <h1><field name="name" placeholder="مثال: خطة الأقساط الفصلية - العام الدراسي 2026"/></h1>
                        </div>
                        <group>
                            <group string="بيانات الخطة">
                                <field name="code" string="رمز الخطة"/>
                                <field name="fees_terms" string="نوع السداد" required="1"/>
                                <field name="company_id" string="المدرسة" groups="base.group_multi_company"/>
                            </group>
                            <group string="الخصومات والشروط">
                                <field name="discount" string="نسبة الخصم المسموح بها (%)"/>
                                <field name="active" string="نشط"/>
                            </group>
                        </group>
                        <field name="note" placeholder="شروط وملاحظات السداد..." class="mt32"/>
                        <separator string="جدول توزيع الأقساط ونسبها" colspan="4"/>
                        <field name="line_ids">
                            <list string="الأقساط">
                                <field name="due_days" string="أيام الاستحقاق"
                                       column_invisible="parent.fees_terms != 'fixed_days'" required="parent.fees_terms == 'fixed_days'"/>
                                <field name="due_date" string="تاريخ الاستحقاق"
                                       column_invisible="parent.fees_terms != 'fixed_date'" required="parent.fees_terms == 'fixed_date'"/>
                                <field name="value" string="نسبة القسط (%)" required="1"/>
                                <field name="fees_element_line" string="بنود الرسوم المشمولة" widget="many2many_tags" required="1"/>
                            </list>
                            <form string="تفاصيل القسط">
                                <group>
                                    <group colspan="4">
                                        <field name="due_days" string="عدد الأيام بعد بدء الدراسة"
                                               invisible="parent.fees_terms != 'fixed_days'" required="parent.fees_terms == 'fixed_days'"/>
                                        <field name="due_date" string="تاريخ الاستحقاق المحدد" invisible="parent.fees_terms != 'fixed_date'" required="parent.fees_terms == 'fixed_date'"/>
                                        <field name="value" string="نسبة القسط من إجمالي الرسوم (%)" required="1"/>
                                    </group>
                                   <separator string="بنود الرسوم التابعة للقسط" colspan="4"/>
                                   <group colspan="4">
                                       <field name="fees_element_line" nolabel="1">
                                           <list string="بنود الرسوم" editable="top">
                                               <field name="product_id" string="بند الخدمة / الرسوم"/>
                                               <field name="value" string="المبلغ / النسبة"/>
                                           </list>
                                       </field>
                                   </group>
                                </group>
                            </form>
                        </field>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_fees_terms_search" model="ir.ui.view">
            <field name="name">op.fees.terms.search</field>
            <field name="model">op.fees.terms</field>
            <field name="type">search</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <search string="البحث في خطط الرسوم">
                    <field name="name" string="مسمى الخطة" select="True"/>
                    <field name="code" string="الرمز"/>
                    <filter string="المؤرشفة" name="inactive"
                            domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="act_open_fees_terms_view">
            <field name="name">خطط وجداول الرسوم</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">op.fees.terms</field>
            <field name="path">fees-terms</field>
            <field name="binding_view_types">form</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_fees_terms_search"/>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_fees_terms_view_form">
            <field name="act_window_id" ref="act_open_fees_terms_view"/>
            <field name="sequence" eval="20"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_fees_terms_form"/>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_fees_terms_view_tree">
            <field name="act_window_id" ref="act_open_fees_terms_view"/>
            <field name="sequence" eval="10"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_fees_terms_tree"/>
        </record>

        <record id="view_op_student_course_form_inherit" model="ir.ui.view">
            <field name="name">op.student.course.form.inherit</field>
            <field name="model">op.student.course</field>
            <field name="inherit_id" ref="openeducat_core.view_op_student_course_form"/>
            <field name="arch" type="xml">
                <field name="academic_years_id" position="after">
                    <field name="fees_term_id" string="خطة الرسوم"/>
                </field>
                <field name="academic_term_id" position="after">
                    <field name="fees_start_date" string="تاريخ بدء سداد الأقساط"/>
                </field>
            </field>
        </record>

</odoo>
