<?xml version="1.0" encoding="UTF-8"?>
<odoo>

        <record id="view_op_student_tree_library_inherit" model="ir.ui.view">
            <field name="name">op.student.list.library.inherit</field>
            <field name="model">op.student</field>
            <field name="inherit_id" ref="openeducat_core.view_op_student_tree"/>
            <field name="priority" eval="9"/>
            <field name="arch" type="xml">
                <field name="emergency_contact" position="before">
                    <field name="library_card_id" string="بطاقة المكتبة"/>
                </field>
            </field>
        </record>

        <record id="view_op_student_form_library_inherit" model="ir.ui.view">
            <field name="name">op.student.form.library.inherit</field>
            <field name="model">op.student</field>
            <field name="inherit_id" ref="openeducat_core.view_op_student_form"/>
            <field name="priority" eval="10"/>
            <field name="arch" type="xml">
                <field name="gr_no" position="after">
                    <field name="library_card_id" string="بطاقة المكتبة"/>
                </field>
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button class="btn oe_stat_button"
                            type="object"
                            name="count_media_movement_lines"
                            style="border-right: 1px solid;"
                            icon="fa-book"
                            groups="openeducat_library.group_op_library_user,openeducat_library.group_op_library">
                        <field string="الكتب المستعارة" name="media_movement_lines_count" widget="statinfo"/>
                    </button>
                </xpath>
            </field>
        </record>

</odoo>
