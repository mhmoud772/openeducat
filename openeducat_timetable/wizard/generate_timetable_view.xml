<?xml version="1.0" encoding="UTF-8"?>
<odoo>

        <record id="view_gen_time_table_line_tree" model="ir.ui.view">
            <field name="name">gen.time.table.line.list</field>
            <field name="model">gen.time.table.line</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <list string="تفاصيل الحصص" editable="bottom">
                    <field name="day" invisible="1"/>
                    <field name="session_start_time" widget="float_time" string="بداية الحصة"/>
                    <field name="session_end_time" widget="float_time" string="نهاية الحصة"/>
                    <field name="faculty_id" string="المعلم / المعلمة"/>
                    <field name="subject_id" string="المادة الدراسية"/>
                    <field name="classroom_id" string="الفصل / القاعة"/>
                </list>
            </field>
        </record>

        <record id="view_gen_time_table_line_form" model="ir.ui.view">
            <field name="name">gen.time.table.line.form</field>
            <field name="model">gen.time.table.line</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <form string="بيانات الحصة">
                    <group>
                        <field name="day" string="اليوم"/>
                        <field name="session_start_time" widget="float_time" string="بداية الحصة"/>
                        <field name="session_end_time" widget="float_time" string="نهاية الحصة"/>
                        <field name="faculty_id" string="المعلم / المعلمة"/>
                        <field name="subject_id" string="المادة الدراسية"/>
                        <field name="classroom_id" string="الفصل / القاعة"/>
                    </group>
                </form>
            </field>
        </record>

        <record id="view_generate_time_table_form" model="ir.ui.view">
            <field name="name">generate.time.table.form</field>
            <field name="model">generate.time.table</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <form string="توليد وتوزيع الجدول المدرسي">
                    <sheet>
                        <group>
                            <group string="المرحلة والصف">
                                <field name="course_id" string="المرحلة التعليمية"/>
                                <field name="batch_id" context="{'course_id': course_id,'get_parent_batch':1}" string="الصف / الشعبة"/>
                            </group>
                            <group string="النطاق الزمني">
                                <field name="start_date" string="تاريخ البداية"/>
                                <field name="end_date" string="تاريخ النهاية"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="sunday" string="الأحد">
                                <field name="time_table_lines_7" nolabel="1" context="{'default_day': '6'}"/>
                            </page>
                            <page name="monday" string="الإثنين">
                                <field name="time_table_lines_1" nolabel="1" context="{'default_day': '0'}"/>
                            </page>
                            <page name="tuesday" string="الثلاثاء">
                                <field name="time_table_lines_2" nolabel="1" context="{'default_day': '1'}"/>
                            </page>
                            <page name="wednesday" string="الأربعاء">
                                <field name="time_table_lines_3" nolabel="1" context="{'default_day': '2'}"/>
                            </page>
                            <page name="thursday" string="الخميس">
                                <field name="time_table_lines_4" nolabel="1" context="{'default_day': '3'}"/>
                            </page>
                            <page name="friday" string="الجمعة">
                                <field name="time_table_lines_5" nolabel="1" context="{'default_day': '4'}"/>
                            </page>
                            <page name="saturday" string="السبت">
                                <field name="time_table_lines_6" nolabel="1" context="{'default_day': '5'}"/>
                            </page>
                        </notebook>
                    </sheet>
                    <footer groups="base.group_user">
                        <button string="توليد وتوزيع الجدول الآن" type="object" name="act_gen_time_table" class="oe_highlight btn-primary"/>
                        <button special="cancel" string="إلغاء" type="object" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="act_open_generate_time_table_view">
            <field name="name">توليد وتوزيع الجدول المدرسي</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">generate.time.table</field>
            <field name="binding_view_types">form</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_generate_time_table_view_form">
            <field name="act_window_id" ref="act_open_generate_time_table_view"/>
            <field name="sequence" eval="20"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_generate_time_table_form"/>
        </record>

</odoo>
