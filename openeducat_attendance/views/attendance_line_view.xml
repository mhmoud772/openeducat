<?xml version="1.0" encoding="UTF-8"?>
<odoo>
        <record id="view_op_attendance_line_tree" model="ir.ui.view">
            <field name="name">op.attendance.line.list</field>
            <field name="model">op.attendance.line</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <list string="سجلات تفاصيل حضور الطلاب">
                    <field name="attendance_date" string="التاريخ"/>
                    <field name="student_id" string="اسم الطالب"/>
                    <field name="course_id" string="المرحلة / الصف" optional="show"/>
                    <field name="batch_id" string="الشعبة" optional="show"/>
                    <field name="present" string="حاضر" widget="boolean_toggle"/>
                    <field name="absent" string="غائب بدون عذر" widget="boolean_toggle"/>
                    <field name="late" string="متأخر" widget="boolean_toggle"/>
                    <field name="excused" string="بعذر" widget="boolean_toggle"/>
                    <field name="parent_mobile" string="جوال ولي الأمر" optional="show"/>
                    <button name="action_send_whatsapp_attendance" string="إشعار واتساب" type="object" icon="fa-whatsapp" class="btn-success" invisible="present == True"/>
                    <field name="remark" string="ملاحظات" optional="hide"/>
                    <field name="attendance_id" string="كشف الحضور" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_op_attendance_line_form" model="ir.ui.view">
            <field name="name">op.attendance.line.form</field>
            <field name="model">op.attendance.line</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <form string="سجل حضور الطالب">
                    <header>
                        <button name="action_send_whatsapp_attendance" string="إرسال إشعار فوري لولي الأمر عبر واتساب" type="object" icon="fa-whatsapp" class="btn-success"/>
                    </header>
                    <sheet>
                        <field name="active" invisible="1"/>
                        <widget name="web_ribbon" title="مؤرشف" bg_color="bg-danger"
                                invisible="active == True"/>
                        <group>
                            <group string="بيانات الحضور والغياب">
                                <field name="student_id" string="اسم الطالب"
                                       domain="[('course_detail_ids.course_id','=',course_id),('course_detail_ids.batch_id','=',batch_id)]"/>
                                <field name="attendance_date" string="تاريخ الحضور"/>
                                <field name="present" string="حاضر" readonly="state == 'done'" />
                                <field name="absent" string="غائب بدون عذر" readonly="state == 'done'" />
                                <field name="late" string="متأخر" readonly="state == 'done'" />
                                <field name="excused" string="غائب بعذر رسمي" readonly="state == 'done'"/>
                                <field name="remark" string="الملاحظات والتبرير"/>
                            </group>
                            <group string="المرحلة والتواصل مع ولي الأمر">
                                <field name="course_id" string="المرحلة / الصف" widget="selection"/>
                                <field name="batch_id" string="الشعبة / الفصل" widget="selection"/>
                                <field name="parent_name" string="اسم ولي الأمر" readonly="1"/>
                                <field name="parent_mobile" string="رقم جوال ولي الأمر" readonly="1"/>
                                <field name="attendance_id" string="كشف الحضور التابع له" widget="selection"/>
                                <field name="state" string="حالة الكشف"/>
                            </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_op_attendance_line_search" model="ir.ui.view">
            <field name="name">op.attendance.line.search</field>
            <field name="model">op.attendance.line</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <search string="البحث في سجلات الحضور">
                    <field name="student_id" string="اسم الطالب"/>
                    <field name="attendance_id" string="كشف الحضور"/>
                    <field name="parent_mobile" string="جوال ولي الأمر"/>
                    <separator/>
                    <filter string="الحاضرون" name="group_by_attendance_present"
                            domain="[('present', '=', True)]"/>
                    <filter string="الغائبون" name="group_by_attendance_absent"
                            domain="[('absent', '=', True)]"/>
                    <filter string="المتأخرون" name="group_by_attendance_late"
                            domain="[('late', '=', True)]"/>
                    <filter string="اليوم" name="group_by_attendance_today"
                            domain="[('attendance_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                    <filter string="المؤرشفة" name="inactive"
                            domain="[('active', '=', False)]"/>
                    <group>
                        <filter string="المرحلة الدراسية" name="group_by_attendance_course"
                                domain="[]" context="{'group_by':'course_id'}"/>
                        <filter string="الشعبة" name="group_by_attendance_batch"
                                domain="[]" context="{'group_by':'batch_id'}"/>
                        <filter string="الطالب" name="group_by_attendance_student"
                                domain="[]" context="{'group_by':'student_id'}"/>
                        <filter string="التاريخ" name="group_by_attendance_date"
                                domain="[]" context="{'group_by':'attendance_date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_op_attendance_line_pivot" model="ir.ui.view">
            <field name="name">op.attendance.line.pivot</field>
            <field name="model">op.attendance.line</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <pivot string="تحليل الحضور والغياب">
                    <field name="attendance_id" type="row"/>
                    <field name="student_id"/>
                    <field name="present"/>
                    <field name="course_id"/>
                    <field name="batch_id"/>
                    <field name="attendance_date"/>
                </pivot>
            </field>
        </record>

        <record model="ir.actions.act_window" id="act_open_op_attendance_line_view">
            <field name="name">تفاصيل حضور وغياب الطلاب</field>
            <field name="path">attendance-line</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">op.attendance.line</field>
            <field name="binding_view_types">form</field>
            <field name="view_mode">list,form,pivot</field>
            <field name="search_view_id" ref="view_op_attendance_line_search"/>
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_op_attendance_line_view_form">
            <field name="act_window_id" ref="act_open_op_attendance_line_view"/>
            <field name="sequence" eval="20"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_op_attendance_line_form"/>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_op_attendance_line_view_tree">
            <field name="act_window_id" ref="act_open_op_attendance_line_view"/>
            <field name="sequence" eval="10"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_op_attendance_line_tree"/>
        </record>

</odoo>
