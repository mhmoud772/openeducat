<?xml version="1.0"?>
<odoo>
        <record model="ir.ui.view" id="student_attendance_form">
            <field name="name">student.attendance.form</field>
            <field name="model">student.attendance</field>
            <field name="arch" type="xml">
                <form string="تقرير حضور وغياب الطالب">
                    <group col="4" colspan="4">
                        <field name="from_date" string="من تاريخ"/>
                        <field name="to_date" string="إلى تاريخ"/>
                    </group>
                    <footer>
                        <span class="w-100" groups="base.group_user">
                            <button string="طباعة التقرير" type="object" name="print_report" class="oe_highlight me-2"/>
                            <button special="cancel" string="إلغاء" type="object" class="btn-secondary"/>
                        </span>
                    </footer>
                </form>
            </field>
        </record>

        <record id="op_student_attendance_act" model="ir.actions.act_window">
            <field name="name">تقرير حضور وغياب الطالب</field>
            <field name="res_model">student.attendance</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="openeducat_core.model_op_student"/>
        </record>

</odoo>
