<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="student_attendance_report">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="layout_document_title">تقرير الحضور والغياب الأكاديمي</t>
                <div class="page" style="direction: rtl; font-family: 'Cairo', 'Tajawal', 'Segoe UI', Tahoma, sans-serif; padding: 20px 25px; color: #0F172A;">
                    <style>
                        .smartedu-attendance-box {
                            border: 2px solid #1E3A8A;
                            border-radius: 14px;
                            padding: 24px;
                            background: #FFFFFF;
                            box-shadow: 0 4px 15px rgba(10, 25, 47, 0.08);
                            position: relative;
                        }
                        .smartedu-attendance-header {
                            display: flex;
                            align-items: center;
                            justify-content: space-between;
                            border-bottom: 2.5px solid #D97706;
                            padding-bottom: 16px;
                            margin-bottom: 20px;
                        }
                        .smartedu-attendance-title {
                            text-align: center;
                            margin: 15px 0 22px 0;
                        }
                        .smartedu-attendance-badge {
                            display: inline-block;
                            font-size: 20px;
                            font-weight: 900;
                            color: #FFFFFF;
                            background: linear-gradient(135deg, #0A192F 0%, #1E3A8A 100%);
                            padding: 6px 32px;
                            border-radius: 20px;
                            border: 1.5px solid #D97706;
                            letter-spacing: 0.5px;
                        }
                        .smartedu-info-grid {
                            background: #F8FAFC;
                            border: 1px solid #E2E8F0;
                            border-radius: 10px;
                            padding: 14px 18px;
                            margin-bottom: 22px;
                            font-size: 13.5px;
                            line-height: 1.8;
                        }
                        .smartedu-stats-grid {
                            display: flex;
                            gap: 12px;
                            justify-content: space-between;
                            margin: 18px 0;
                        }
                        .smartedu-stat-card {
                            flex: 1;
                            text-align: center;
                            padding: 12px 8px;
                            border-radius: 8px;
                            border: 1px solid #E2E8F0;
                            background: #FFFFFF;
                            box-shadow: 0 2px 5px rgba(0,0,0,0.04);
                        }
                        .smartedu-stat-value {
                            font-size: 22px;
                            font-weight: 800;
                            display: block;
                            margin-top: 4px;
                        }
                        .smartedu-stat-label {
                            font-size: 12px;
                            color: #64748B;
                            font-weight: 600;
                        }
                        .smartedu-table {
                            width: 100%;
                            border-collapse: collapse;
                            margin: 18px 0;
                            font-size: 13px;
                        }
                        .smartedu-table th {
                            background: linear-gradient(135deg, #0A192F 0%, #1E3A8A 100%);
                            color: #FFFFFF;
                            padding: 10px 12px;
                            text-align: center;
                            font-weight: 700;
                            border: 1px solid #1E3A8A;
                        }
                        .smartedu-table td {
                            padding: 9px 12px;
                            border: 1px solid #E2E8F0;
                            text-align: center;
                        }
                        .smartedu-table tr:nth-child(even) {
                            background-color: #F8FAFC;
                        }
                        .smartedu-status-badge {
                            padding: 3px 10px;
                            border-radius: 12px;
                            font-weight: 700;
                            font-size: 12px;
                            display: inline-block;
                        }
                        .status-present { background-color: #DEF7EC; color: #03543F; border: 1px solid #BCF0DA; }
                        .status-absent { background-color: #FDE8E8; color: #9B1C1C; border: 1px solid #FBD5D5; }
                        .status-late { background-color: #FEF08A; color: #713F12; border: 1px solid #FDE047; }
                        .status-excused { background-color: #E1EFFE; color: #1E429F; border: 1px solid #C3DDFD; }
                        .smartedu-footer-signatures {
                            display: flex;
                            justify-content: space-between;
                            margin-top: 36px;
                            padding-top: 18px;
                            border-top: 1.5px dashed #CBD5E1;
                            text-align: center;
                            font-size: 13.5px;
                        }
                    </style>

                    <div class="smartedu-attendance-box">
                        <!-- Header Details -->
                        <div class="smartedu-attendance-header">
                            <div style="text-align: right;">
                                <div style="font-size: 15px; font-weight: 800; color: #0A192F;">
                                    <span t-if="student and student.company_id" t-esc="student.company_id.name"/>
                                    <span t-else="">نظام سمارت إديو لإدارة المدارس والمنصات التعليمية</span>
                                </div>
                                <div style="font-size: 12px; color: #64748B; margin-top: 4px;">قسم شؤون الطلاب والانضباط المدرسي</div>
                            </div>
                            <div style="text-align: left;">
                                <div style="font-size: 12px; color: #64748B;">تاريخ استخراج التقرير:</div>
                                <div style="font-size: 13px; font-weight: 700; color: #0A192F;" t-esc="time.strftime('%Y/%m/%d')"/>
                            </div>
                        </div>

                        <!-- Report Main Title -->
                        <div class="smartedu-attendance-title">
                            <div class="smartedu-attendance-badge">
                                📋 كشف تفصيلي للحضور والغياب الأكاديمي
                            </div>
                        </div>

                        <!-- Student Information Grid -->
                        <div class="smartedu-info-grid">
                            <table style="width: 100%; border-collapse: collapse;">
                                <tr>
                                    <td style="width: 50%; padding: 4px 0;">
                                        <strong style="color: #1E3A8A;">اسم الطالب:</strong>
                                        <span style="font-weight: 700; color: #0F172A;" t-esc="student_name"/>
                                    </td>
                                    <td style="width: 50%; padding: 4px 0;">
                                        <strong style="color: #1E3A8A;">الرقم الأكاديمي / القيد:</strong>
                                        <span style="font-weight: 700;" t-esc="student and student.gr_no or '—'"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 4px 0;">
                                        <strong style="color: #1E3A8A;">الصف والمرحلة:</strong>
                                        <span t-if="student and student.course_detail_ids" t-esc="student.course_detail_ids[0].course_id.name"/>
                                        <span t-else="">—</span>
                                    </td>
                                    <td style="padding: 4px 0;">
                                        <strong style="color: #1E3A8A;">الشعبة / الفصل:</strong>
                                        <span t-if="student and student.course_detail_ids" t-esc="student.course_detail_ids[0].batch_id.name"/>
                                        <span t-else="">—</span>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 4px 0;">
                                        <strong style="color: #1E3A8A;">من تاريخ:</strong>
                                        <span t-esc="from_date or 'بداية العام'" t-options="{'widget': 'date'}"/>
                                    </td>
                                    <td style="padding: 4px 0;">
                                        <strong style="color: #1E3A8A;">إلى تاريخ:</strong>
                                        <span t-esc="to_date or 'تاريخ اليوم'" t-options="{'widget': 'date'}"/>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- Summary Cards -->
                        <div class="smartedu-stats-grid">
                            <div class="smartedu-stat-card" style="border-top: 3px solid #10B981;">
                                <span class="smartedu-stat-label">أيام الحضور</span>
                                <span class="smartedu-stat-value" style="color: #047857;" t-esc="present_count or 0"/>
                            </div>
                            <div class="smartedu-stat-card" style="border-top: 3px solid #EF4444;">
                                <span class="smartedu-stat-label">أيام الغياب</span>
                                <span class="smartedu-stat-value" style="color: #B91C1C;" t-esc="absent_count or 0"/>
                            </div>
                            <div class="smartedu-stat-card" style="border-top: 3px solid #F59E0B;">
                                <span class="smartedu-stat-label">مرات التأخير</span>
                                <span class="smartedu-stat-value" style="color: #B45309;" t-esc="late_count or 0"/>
                            </div>
                            <div class="smartedu-stat-card" style="border-top: 3px solid #3B82F6;">
                                <span class="smartedu-stat-label">الاستئذان المبرر</span>
                                <span class="smartedu-stat-value" style="color: #1D4ED8;" t-esc="excused_count or 0"/>
                            </div>
                            <div class="smartedu-stat-card" style="border-top: 3px solid #1E3A8A; background: #F8FAFC;">
                                <span class="smartedu-stat-label">إجمالي السجلات</span>
                                <span class="smartedu-stat-value" style="color: #1E3A8A;" t-esc="(present_count or 0) + (absent_count or 0) + (late_count or 0) + (excused_count or 0)"/>
                            </div>
                        </div>

                        <!-- Attendance Log Table -->
                        <table class="smartedu-table">
                            <thead>
                                <tr>
                                    <th style="width: 8%;">م</th>
                                    <th style="width: 25%;">التاريخ</th>
                                    <th style="width: 25%;">حالة الحضور</th>
                                    <th style="width: 42%;">ملاحظات وإيضاح التبرير</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="absences">
                                    <t t-set="row_idx" t-value="0"/>
                                    <t t-foreach="absences" t-as="l">
                                        <t t-set="row_idx" t-value="row_idx + 1"/>
                                        <tr>
                                            <td><span t-esc="row_idx"/></td>
                                            <td style="font-weight: 600;">
                                                <span t-esc="l['absent_date']" t-options="{'widget': 'date'}"/>
                                            </td>
                                            <td>
                                                <t t-if="l['remark'] == 'Present'">
                                                    <span class="smartedu-status-badge status-present">✓ حاضر</span>
                                                </t>
                                                <t t-elif="l['remark'] == 'Absent'">
                                                    <span class="smartedu-status-badge status-absent">✗ غائب</span>
                                                </t>
                                                <t t-elif="l['remark'] == 'Late'">
                                                    <span class="smartedu-status-badge status-late">⏱ متأخر</span>
                                                </t>
                                                <t t-elif="l['remark'] == 'Excused'">
                                                    <span class="smartedu-status-badge status-excused">✉ بعذر رسمي</span>
                                                </t>
                                                <t t-else="">
                                                    <span class="smartedu-status-badge" t-esc="l['remark']"/>
                                                </t>
                                            </td>
                                            <td style="text-align: right;">
                                                <span t-if="l.get('remark_text')" t-esc="l['remark_text']"/>
                                                <span t-elif="l['remark'] == 'Present'" class="text-muted">حضور نظامي في الوقت المحدد</span>
                                                <t t-elif="l['remark'] == 'Excused'">
                                                    <span class="text-primary">تم تقديم إشعار عذر معتمد</span>
                                                </t>
                                                <t t-elif="l['remark'] == 'Late'">
                                                    <span class="text-warning">تأخر عن الاصطفاف / الحصة الأولى</span>
                                                </t>
                                                <t t-else="">
                                                    <span class="text-danger">غياب بدون عذر مسبق</span>
                                                </t>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                                <t t-else="">
                                    <tr>
                                        <td colspan="4" style="padding: 24px; text-align: center; color: #047857; background: #F0FDF4; font-weight: 700;">
                                            🌟 سجل انضباط مثالي! لا توجد أي حالات غياب أو تأخير مسجلة للطالب خلال الفترة المحددة.
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Official Signatures -->
                        <div class="smartedu-footer-signatures">
                            <div style="width: 30%;">
                                <div style="font-weight: 700; color: #1E3A8A;">مسؤول مراقبة الحضور</div>
                                <div style="margin-top: 38px; color: #94A3B8;">...................................</div>
                            </div>
                            <div style="width: 30%;">
                                <div style="font-weight: 700; color: #1E3A8A;">المرشد الأكاديمي والطلابي</div>
                                <div style="margin-top: 38px; color: #94A3B8;">...................................</div>
                            </div>
                            <div style="width: 30%;">
                                <div style="font-weight: 700; color: #1E3A8A;">الختم الرسمي للمدرسة</div>
                                <div style="margin: 10px auto 0 auto; width: 65px; height: 65px; border: 1.5px dashed #D97706; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #D97706; font-size: 11px;">
                                    الختم المعتمد
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
