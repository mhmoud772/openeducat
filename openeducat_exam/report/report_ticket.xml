<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_ticket">
        <t t-call="web.html_container">
            <t t-foreach="get_data" t-as="ticket_data">
                <t t-set="o" t-value="docs"/>
                <t t-call="web.external_layout">
                    <div class="page" style="direction: rtl; font-family: 'Tahoma', 'Arial', sans-serif;">
                        <div class="oe_structure" id="report_ticket_structure"/>
                        <div class="text-center mt-4 mb-2">
                            <h2 class="mt-2 mb-2">
                                <strong>ورقة الجلوس للامتحان</strong>
                            </h2>
                            <p class="text-muted fs-6">Hall Ticket</p>
                        </div>
                        <div class="text-center mb-4">
                            <h4 class="mt-0 text-muted">
                                (<span t-out="ticket_data['exam'] if ticket_data['exam'] else ''"/>
                                <span t-out="ticket_data['exam_code'] if ticket_data['exam_code'] else ''"/>)
                            </h4>
                        </div>
                        <div id="informations" class="row mt-4 mb-4 align-items-center">
                            <div class="col-10">
                                <div class="row">
                                    <div class="col-auto col-4 mw-100 mb-2">
                                        <strong>اسم الطالب:</strong>
                                        <p class="m-0" t-out="ticket_data['student']"/>
                                    </div>
                                    <div class="col-auto col-4 mw-100 mb-2">
                                        <strong>رقم الجلوس:</strong>
                                        <p class="m-0" t-out="ticket_data['roll_number'] if ticket_data['roll_number'] else ''"/>
                                    </div>
                                    <div class="col-auto col-4 mw-100 mb-2">
                                        <strong>المقرر:</strong>
                                        <p class="m-0" t-out="ticket_data['course'] if ticket_data['course'] else ''"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-2 text-start">
                                <img t-if="ticket_data['image']" alt="صورة الطالب"
                                     t-att-src="image_data_uri(ticket_data['image'])"
                                     style="max-height: 120px; object-fit: contain; border-radius: 6px;" class="img-thumbnail border p-1 m-0"/>
                            </div>
                        </div>
                        <table class="table table-sm o_main_table mt-4 mb-0" name="ticket_table"
                               style="border-collapse: collapse;">
                            <thead style="background: #1a6dbf; color: white;">
                                <tr>
                                    <th class="text-center p-2">المادة الدراسية</th>
                                    <th class="text-center p-2">التاريخ</th>
                                    <th class="text-center p-2">الوقت</th>
                                    <th class="text-center p-2">توقيع المراقب</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="ticket_data['line']" t-as="s" style="border-bottom: 1px solid #dee2e6;">
                                    <td class="text-center p-2">
                                        <span t-out="s['subject'] if s['subject'] else ''"/>
                                    </td>
                                    <td class="text-center p-2">
                                        <span t-out="s['date'] if s['date'] else ''" t-options="{'widget':'date'}"/>
                                    </td>
                                    <td class="text-center p-2">
                                        <span t-esc="s['time']"/>
                                    </td>
                                    <td class="text-center p-2">
                                        <span t-out="s['sup_sign'] if s['sup_sign'] else ''"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <!-- تعليمات للطالب -->
                        <div class="mt-4 p-3" style="background: #f8f9fa; border-right: 4px solid #1a6dbf; border-radius: 4px; font-size: 12px;">
                            <strong>تعليمات هامة:</strong>
                            <ul class="mb-0 mt-1">
                                <li>يجب إحضار هذه الورقة في يوم الامتحان</li>
                                <li>يُمنع الدخول بدون ورقة الجلوس</li>
                                <li>يجب الحضور قبل موعد الامتحان بـ 15 دقيقة</li>
                            </ul>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
